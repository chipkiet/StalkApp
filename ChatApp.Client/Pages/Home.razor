    // ── Call Logic (WebRTC) ──────────────────────────────────
    private async Task InitiateCall(bool isVideo)
    {
        if (hubConnection == null || selectedId == Guid.Empty) return;

        isCalling = true;
        activeCallType = isVideo ? ChatApp.Domain.Enums.CallType.Video : ChatApp.Domain.Enums.CallType.Voice;
        activeConversationId = selectedId; // ← Lưu đúng conversationId lúc gọi
        isAudioMuted = false;
        isVideoMuted = false;
        StateHasChanged();

        bool initSuccess = await JS.InvokeAsync<bool>("window.WebRTC.init", objRef, isVideo);
        if (!initSuccess)
        {
            EndCallCleanup();
            return;
        }

        var command = new
        {
            ConversationId = selectedId,
            CallerId = currentUserId,
            Type = activeCallType
        };
        await hubConnection.SendAsync("InitiateCall", command);
    }

    private async Task AcceptCall()
    {
        if (hubConnection == null) return;

        isIncomingCall = false;
        isCalling = true;
        activeCallId = incomingCallId;
        activeConversationId = incomingConversationId; // ← Dùng conversationId của cuộc gọi đến
        activeCallType = incomingCallType;
        isAudioMuted = false;
        isVideoMuted = false;
        StateHasChanged();

        bool isVideo = activeCallType == ChatApp.Domain.Enums.CallType.Video;
        bool initSuccess = await JS.InvokeAsync<bool>("window.WebRTC.init", objRef, isVideo);
        if (!initSuccess)
        {
            if (hubConnection != null)
            {
                await hubConnection.SendAsync("RejectCall", incomingCallId, incomingConversationId.ToString());
            }
            EndCallCleanup();
            return;
        }

        await hubConnection.SendAsync("AcceptCall", incomingCallId, incomingConversationId.ToString());
        StartCallTimer();
    }

    private async Task RejectCall()
    {
        if (hubConnection != null)
        {
            await hubConnection.SendAsync("RejectCall", incomingCallId, incomingConversationId.ToString());
        }
        isIncomingCall = false;
        StateHasChanged();
    }

    private async Task EndCall()
    {
        if (hubConnection != null)
        {
            await hubConnection.SendAsync("EndCall", activeCallId, activeConversationId.ToString());
        }
        EndCallCleanup();
    }

    private void EndCallCleanup()
    {
        isCalling = false;
        isIncomingCall = false;
        activeCallId = Guid.Empty;
        activeConversationId = Guid.Empty;
        incomingConversationId = Guid.Empty;
        StopCallTimer();
        JS.InvokeVoidAsync("window.WebRTC.endCall");
        StateHasChanged();
    }

    private void StartCallTimer()
    {
        callSeconds = 0;
        callTimerDisplay = "00:00";
        if (callTimer == null)
        {
            callTimer = new System.Timers.Timer(1000);
            callTimer.Elapsed += (sender, e) =>
            {
                callSeconds++;
                var ts = TimeSpan.FromSeconds(callSeconds);
                callTimerDisplay = ts.ToString(@"mm\:ss");
                InvokeAsync(StateHasChanged);
            };
        }
        callTimer.Start();
    }

    private void StopCallTimer()
    {
        if (callTimer != null)
        {
            callTimer.Stop();
        }
    }

    private void ToggleAudio()
    {
        isAudioMuted = !isAudioMuted;
        JS.InvokeVoidAsync("window.WebRTC.toggleAudio", !isAudioMuted);
        StateHasChanged();
