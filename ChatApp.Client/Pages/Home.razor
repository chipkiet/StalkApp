@page "/"
@attribute [Authorize]
@using ChatApp.Application.DTOs.Conversations
@using ChatApp.Application.DTOs.Messages
@using ChatApp.Domain.Enums
@using ChatApp.Shared.DTOs.Pinboard
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject AuthenticationStateProvider AuthStateProvider
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ChatApp.Client.Layout.NotificationService NotificationSvc

<PageTitle>Tin nhắn – STALKchat</PageTitle>

<div class="chat-shell" @onmousemove="HandleMouseMove" @onmouseup="HandleMouseUp" @onmouseleave="HandleMouseUp" style="@(isResizing ? "cursor: col-resize; user-select: none;" : "")">

    <!-- ═══ CỘT TRÁI: INBOX LIST ═══ -->
    <div class="inbox-panel" style="width: @(inboxWidth)px; position: relative;">
        <div class="inbox-header">
            <h2 class="inbox-title">Tin nhắn</h2>
            <button class="inbox-new-btn" title="Tạo cuộc trò chuyện mới" @onclick="OpenNewConvModal">＋</button>
        </div>

        @if (isLoading)
        {
            @for (int i = 0; i < 5; i++)
            {
                <div class="conversation-skeleton">
                    <div class="skel-avatar"></div>
                    <div class="skel-lines">
                        <div class="skel-line skel-line-title"></div>
                        <div class="skel-line skel-line-sub"></div>
                    </div>
                </div>
            }
        }
        else if (errorMessage != null)
        {
            <div class="inbox-error">
                <span>⚠️</span>
                <p>@errorMessage</p>
                <button class="btn-retry" @onclick="LoadInbox">Thử lại</button>
            </div>
        }
        else if (inboxItems == null || !inboxItems.Any())
        {
            <div class="inbox-empty">
                <div class="inbox-empty-icon">💬</div>
                <p>Chưa có cuộc trò chuyện nào</p>
                <span>Nhấn <strong>＋</strong> để bắt đầu</span>
            </div>
        }
        else
        {
            <div class="conversation-list">
                @foreach (var item in inboxItems)
                {
                    <div class="conversation-item @(selectedId == item.ConversationId ? "active" : "")"
                         @onclick="() => SelectConversation(item)">
                        <div class="conv-avatar">
                            @if (!string.IsNullOrEmpty(item.AvatarUrl))
                            {
                                <img src="@item.AvatarUrl" style="width:100%;height:100%;border-radius:50%;object-fit:cover;"/>
                            }
                            else
                            {
                                @GetInitials(item.Title)
                            }
                        </div>
                        <div class="conv-info">
                            <div class="conv-top" style="display: flex; justify-content: space-between; align-items: center;">
                                <span class="conv-name" style="display: flex; align-items: center; gap: 4px;">
                                    @if (item.IsPinned) { <span title="Đã ghim">📌</span> }
                                    @(item.Title ?? "Cuộc trò chuyện")
                                </span>
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <button class="btn-pin-conv" style="background: none; border: none; cursor: pointer; padding: 0; font-size: 0.9rem; opacity: 0.5;"
                                            @onclick:stopPropagation="true" 
                                            @onclick="() => TogglePin(item.ConversationId, !item.IsPinned)" 
                                            title="@(item.IsPinned ? "Bỏ ghim" : "Ghim hội thoại")">
                                        @(item.IsPinned ? "📌" : "📍")
                                    </button>
                                    <span class="conv-time">@FormatTime(item.LastMessageAt)</span>
                                </div>
                            </div>
                            <div class="conv-bottom">
                                <span class="conv-preview">@TruncateMessage(item.LastMessage)</span>
                                @if (item.UnreadCount > 0)
                                {
                                    <span class="conv-badge">@(item.UnreadCount > 99 ? "99+" : item.UnreadCount.ToString())</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        
        <!-- Thanh kéo (Resizer) nằm đè lên viền phải cột trái -->
        <div class="layout-resizer" @onmousedown="HandleMouseDown" @onmousedown:preventDefault="true" @onmousedown:stopPropagation="true"></div>
    </div>

    <!-- ═══ CỘT PHẢI: VÙNG CHAT ═══ -->
    <div class="chat-panel">
        @if (selectedConversation == null)
        {
            <div class="chat-placeholder">
                <div class="placeholder-logo">
                    <div class="placeholder-logo-s">S</div>
                    <div class="placeholder-logo-text">STALK</div>
                </div>
                <p class="placeholder-title">Chào mừng đến với STALKchat</p>
                <p class="placeholder-sub">Chọn một cuộc trò chuyện hoặc nhấn <strong>＋</strong> để bắt đầu</p>
            </div>
        }
        else
        {
            <div class="chat-header">
                <div class="chat-header-clickable" @onclick="OpenProfileModal" style="display: flex; align-items: center; gap: 12px; cursor: pointer; flex-grow: 1;">
                    <div class="chat-header-avatar">
                        @if (!string.IsNullOrEmpty(selectedConversation.AvatarUrl))
                        {
                            <img src="@selectedConversation.AvatarUrl" style="width:100%;height:100%;border-radius:50%;object-fit:cover;"/>
                        }
                        else
                        {
                            @GetInitials(selectedConversation.Title)
                        }
                    </div>
                    <div class="chat-header-info">
                        <div class="chat-header-name">@(selectedConversation.Title ?? "Cuộc trò chuyện")</div>
                        <div class="chat-header-status">STALKchat</div>
                    </div>
                </div>
                <div class="chat-header-actions">
                    <button class="btn-call" title="Bảng Công Việc (Pinboard)" @onclick="ToggleCanvas" style="@(isCanvasOpen ? "color: var(--accent);" : "")">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="7.5 4.21 12 6.81 16.5 4.21"></polyline><polyline points="7.5 19.79 7.5 14.6 3 12"></polyline><polyline points="21 12 16.5 14.6 16.5 19.79"></polyline><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                    </button>
                    <button class="btn-call" title="Gọi thoại" @onclick="() => InitiateCall(false)">📞</button>
                    <button class="btn-call" title="Gọi video" @onclick="() => InitiateCall(true)">📹</button>
                    <button class="btn-call" style="color: #ff4d4f;" title="Xóa cuộc trò chuyện" @onclick="() => OpenDeleteModal(selectedConversation.ConversationId)">🗑️</button>
                </div>
            </div>
            <div class="chat-messages-area" id="chat-messages-area">
                @if (isLoadingMessages)
                {
                    <div class="chat-loading" style="text-align: center; margin-top: 20px; color: var(--text-muted);">
                        <span class="spinner-sm" style="border-color: var(--accent); border-top-color: transparent;"></span>
                        <span style="margin-left: 8px;">Đang tải tin nhắn...</span>
                    </div>
                }
                else if (messages != null && messages.Any())
                {
                    <div class="chat-message-list">
                        @foreach (var msg in messages)
                        {
                            bool isSelf = msg.SenderId == currentUserId;
                            <div class="chat-msg @(isSelf ? "msg-self" : "msg-other")">
                                @if (isSelf)
                                {
                                    <div class="msg-actions">
                                        <button class="btn-msg-action" title="Trả lời" @onclick="() => SetReply(msg)">↩</button>
                                        <button class="btn-msg-action" title="Chuyển tiếp" @onclick="() => OpenForwardModal(msg.Id)">↪</button>
                                    </div>
                                }
                                else
                                {
                                    <div class="msg-avatar">
                                        @if (!string.IsNullOrEmpty(selectedConversation?.AvatarUrl))
                                        {
                                            <img src="@selectedConversation.AvatarUrl" style="width:100%;height:100%;border-radius:50%;object-fit:cover;"/>
                                        }
                                        else
                                        {
                                            @GetInitials(selectedConversation?.Title)
                                        }
                                    </div>
                                }
                                <div class="msg-content-wrapper">
                                    <div class="msg-bubble chat-bubble draggable" data-msg-id="@msg.Id">
                                        @if (msg.ReplyTo != null)
                                        {
                                            <div class="msg-quoted">
                                                <div class="quoted-author">Đã trả lời</div>
                                                <div class="quoted-content">@TruncateMessage(msg.ReplyTo.Content ?? "Tệp đính kèm")</div>
                                            </div>
                                        }
                                        @if (msg.MessageType == MessageType.Image && !string.IsNullOrEmpty(msg.AttachmentUrl))
                                        {
                                            <img src="@msg.AttachmentUrl" class="msg-image" alt="image" />
                                        }
                                        else if (msg.MessageType == MessageType.File && !string.IsNullOrEmpty(msg.AttachmentUrl))
                                        {
                                            <a href="@msg.AttachmentUrl" target="_blank" class="msg-file">
                                                <span>📄</span> @(msg.AttachmentName ?? "File đính kèm")
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="msg-content">@msg.Content</span>
                                        }
                                    </div>
                                    @if (msg.Reactions != null && msg.Reactions.Any())
                                    {
                                        <div class="msg-reactions">
                                            @foreach (var r in msg.Reactions.GroupBy(x => x.Emotion))
                                            {
                                                <span class="reaction-badge" title="Đã thả cảm xúc">@r.Key @r.Count()</span>
                                            }
                                        </div>
                                    }
                                    <span class="msg-time">@msg.CreatedAt.ToLocalTime().ToString("HH:mm")</span>
                                </div>
                                @if (!isSelf)
                                {
                                    <div class="msg-actions">
                                        <div class="reaction-picker-wrapper">
                                            <button class="btn-msg-action btn-react" title="Thả cảm xúc">☺</button>
                                            <div class="reaction-picker">
                                                <button @onclick='() => AddReaction(msg.Id, "👍")'>👍</button>
                                                <button @onclick='() => AddReaction(msg.Id, "❤️")'>❤️</button>
                                                <button @onclick='() => AddReaction(msg.Id, "😂")'>😂</button>
                                                <button @onclick='() => AddReaction(msg.Id, "😲")'>😲</button>
                                                <button @onclick='() => AddReaction(msg.Id, "😢")'>😢</button>
                                                <button @onclick='() => AddReaction(msg.Id, "😡")'>😡</button>
                                            </div>
                                        </div>
                                        <button class="btn-msg-action" title="Trả lời" @onclick="() => SetReply(msg)">↩</button>
                                        <button class="btn-msg-action" title="Chuyển tiếp" @onclick="() => OpenForwardModal(msg.Id)">↪</button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="chat-empty" style="text-align: center; margin-top: 40px; color: var(--text-muted);">
                        <p>Chưa có tin nhắn nào. Hãy bắt đầu cuộc trò chuyện!</p>
                    </div>
                }
            </div>

            @if (isUploading)
            {
                <div style="padding: 4px 16px; font-size: 0.8rem; color: var(--text-muted); background: var(--bg-main);">
                    <span class="spinner-sm" style="border-color: var(--text-muted); border-top-color: transparent; width: 10px; height: 10px; display: inline-block;"></span>
                    Đang tải file lên...
                </div>
            }

            @if (replyingToMessage != null)
            {
                <div class="reply-indicator">
                    <div class="reply-info">
                        <span class="reply-title">Đang trả lời tin nhắn</span>
                        <span class="reply-text">@TruncateMessage(replyingToMessage.Content ?? "Tệp đính kèm")</span>
                    </div>
                    <button class="btn-cancel-reply" @onclick="ClearReply" title="Hủy trả lời">✕</button>
                </div>
            }

            <div class="chat-input-area">
                <button class="btn-attach" @onclick="TriggerFileInput" title="Đính kèm file/ảnh">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path></svg>
                </button>
                <InputFile OnChange="HandleFileSelected" class="file-input-hidden" id="chatFileInput" />
                
                <input class="chat-input"
                       type="text"
                       placeholder="Nhập tin nhắn..."
                       @bind="newMessageContent"
                       @bind:event="oninput"
                       @onkeydown="OnMessageKeyDown" />
                <button class="chat-send-btn" 
                        @onclick="SendMessage" 
                        disabled="@(string.IsNullOrWhiteSpace(newMessageContent) && !isUploading)">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                </button>
            </div>
        }
    </div>

    <!-- ═══ CỘT PHẢI: CANVAS PINBOARD ═══ -->
    <div class="canvas-panel @(isCanvasOpen ? "open" : "closed")">
        <ChatApp.Client.Components.Pinboard.CanvasBoard 
            Items="@MyCanvasItems" 
            Connections="@MyCanvasConnections"
            OnItemMoved="HandleItemMoved" 
            OnTaskCompleted="HandleTaskCompleted" 
            OnItemDeleted="HandleItemDeleted"
            OnItemCreatedFromDrop="HandleItemCreatedFromDrop"
            OnItemContentUpdated="HandleItemContentUpdated"
            OnConnectionCreated="HandleConnectionCreated" />
    </div>
</div>

<!-- ═══ MODAL CUỘC GỌI ĐẾN (INCOMING CALL) ═══ -->
@if (isIncomingCall)
{
    <div class="modal-backdrop">
        <div class="call-incoming-box">
            <div class="call-incoming-avatar">@GetInitials(incomingCallTitle)</div>
            <h3>@(incomingCallTitle) đang gọi...</h3>
            <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 20px;">
                @(incomingCallType == ChatApp.Domain.Enums.CallType.Video ? "Cuộc gọi Video" : "Cuộc gọi thoại")
            </p>
            <div class="call-incoming-actions">
                <button class="btn-reject-call" @onclick="RejectCall">
                    <span style="transform: rotate(135deg); display: inline-block;">📞</span>
                </button>
                <button class="btn-accept-call" @onclick="AcceptCall">
                    📞
                </button>
            </div>
        </div>
    </div>
}

<!-- ═══ MÀN HÌNH ĐANG GỌI (ACTIVE CALL OVERLAY) ═══ -->
@if (isCalling)
{
    <div class="call-overlay @(activeCallType == ChatApp.Domain.Enums.CallType.Video ? "call-video-mode" : "call-audio-mode")">
        @if (activeCallType == ChatApp.Domain.Enums.CallType.Video)
        {
            <div class="video-container">
                <video id="remoteVideo" autoplay playsinline></video>
                <video id="localVideo" autoplay playsinline muted></video>
            </div>
        }
        else
        {
            <div class="audio-call-container">
                <div class="call-incoming-avatar" style="width: 120px; height: 120px; font-size: 3rem;">
                    @GetInitials(incomingCallTitle ?? selectedConversation?.Title)
                </div>
                <h2>Đang gọi thoại...</h2>
                <div class="call-timer">@callTimerDisplay</div>
            </div>
            <!-- Ẩn thẻ video khi gọi thoại để WebRTC vẫn có nơi gắn stream -->
            <div style="display: none;">
                <video id="remoteVideo" autoplay playsinline></video>
                <video id="localVideo" autoplay playsinline muted></video>
            </div>
        }

        <div class="call-controls">
            <button class="btn-call-control @(isAudioMuted ? "muted" : "")" @onclick="ToggleAudio" title="Tắt/Bật Mic">
                @(isAudioMuted ? "🔇" : "🎤")
            </button>
            @if (activeCallType == ChatApp.Domain.Enums.CallType.Video)
            {
                <button class="btn-call-control @(isVideoMuted ? "muted" : "")" @onclick="ToggleVideo" title="Tắt/Bật Camera">
                    @(isVideoMuted ? "🚫" : "📷")
                </button>
            }
            <button class="btn-call-control btn-end-call" @onclick="EndCall" title="Kết thúc">
                <span style="transform: rotate(135deg); display: inline-block;">📞</span>
            </button>
        </div>
    </div>
}

<!-- ═══ MODAL XÓA CUỘC TRÒ CHUYỆN ═══ -->
@if (showDeleteConvModal)
{
    <div class="modal-backdrop" @onclick="CloseDeleteModal">
        <div class="modal-box" @onclick:stopPropagation="true" style="max-width: 400px; text-align: center; padding: 24px;">
            <div style="font-size: 3.5rem; margin-bottom: 12px;">🗑️</div>
            <h3 style="margin-bottom: 12px; font-size: 1.25rem;">Xóa cuộc trò chuyện?</h3>
            <p style="font-size: 0.95rem; color: var(--text-muted); margin-bottom: 24px; line-height: 1.5;">
                Bạn có chắc chắn muốn xóa cuộc trò chuyện này không?<br/>
                Người kia vẫn sẽ nhìn thấy cuộc trò chuyện.
            </p>
            <div style="display: flex; gap: 12px; justify-content: center;">
                <button class="btn-cancel" style="flex: 1; padding: 10px; border-radius: 8px; border: none; background: #3a3b3c; color: white; cursor: pointer; font-weight: 500;" @onclick="CloseDeleteModal">Hủy</button>
                <button class="btn-confirm-delete" style="flex: 1; padding: 10px; border-radius: 8px; border: none; background: #ff4d4f; color: white; cursor: pointer; font-weight: 500;" @onclick="ConfirmDeleteConversation">Xóa</button>
            </div>
        </div>
    </div>
}

<!-- ═══ MODAL CHUYỂN TIẾP TIN NHẮN ═══ -->
@if (isForwardModalOpen)
{
    <div class="modal-backdrop" @onclick="CloseForwardModal">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Chuyển tiếp tin nhắn</h3>
                <button class="modal-close-btn" @onclick="CloseForwardModal">✕</button>
            </div>
            <div class="modal-body" style="padding-top: 10px;">
                <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 10px;">Chọn đoạn chat để chuyển tiếp:</p>
                
                @if (forwardInboxItems == null || !forwardInboxItems.Any())
                {
                    <p style="text-align: center; color: var(--text-muted); font-size: 0.85rem;">Không có cuộc trò chuyện nào khác.</p>
                }
                else
                {
                    <div class="forward-list">
                        @foreach (var item in forwardInboxItems)
                        {
                            <div class="forward-item">
                                <div class="forward-avatar">
                                    @if (!string.IsNullOrEmpty(item.AvatarUrl))
                                    {
                                        <img src="@item.AvatarUrl" style="width:100%;height:100%;border-radius:50%;object-fit:cover;"/>
                                    }
                                    else
                                    {
                                        @GetInitials(item.Title)
                                    }
                                </div>
                                <div class="forward-name">@(item.Title ?? "Cuộc trò chuyện")</div>
                                <button class="btn-forward-send" @onclick="() => ForwardMessage(item.ConversationId)" disabled="@isForwarding">Gửi</button>
                            </div>
                        }
                    </div>
                }
            </div>
            @if (forwardError != null)
            {
                <div class="modal-error" style="margin: 0 20px 12px;">@forwardError</div>
            }
        </div>
    </div>
}

<!-- ═══ MODAL TẠO CUỘC TRÒ CHUYỆN MỚI ═══ -->
@if (showNewConvModal)
{
    <div class="modal-backdrop" @onclick="CloseModal">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Cuộc trò chuyện mới</h3>
                <button class="modal-close-btn" @onclick="CloseModal">✕</button>
            </div>

            <!-- Tab chọn loại -->
            <div class="modal-tabs">
                <button class="modal-tab @(convType == ConversationType.Direct ? "active" : "")"
                        @onclick='() => convType = ConversationType.Direct'>
                    👤 Tin nhắn trực tiếp
                </button>
                <button class="modal-tab @(convType == ConversationType.Group ? "active" : "")"
                        @onclick='() => convType = ConversationType.Group'>
                    👥 Tạo nhóm
                </button>
            </div>

            <div class="modal-body">
                @if (convType == ConversationType.Direct)
                {
                    <!-- Tìm user theo SĐT -->
                    <div class="modal-form-group">
                        <label class="modal-label">Tìm theo số điện thoại</label>
                        <div class="modal-search-row">
                            <input class="modal-input"
                                   type="tel"
                                   placeholder="Nhập số điện thoại..."
                                   @bind="searchPhone"
                                   @bind:event="oninput"
                                   @onkeydown="OnSearchKeyDown" />
                            <button class="modal-search-btn" @onclick="SearchUser" disabled="@isSearching">
                                @if (isSearching) { <span class="spinner-sm"></span> } else { <span>Tìm</span> }
                            </button>
                        </div>
                    </div>

                    @if (searchError != null)
                    {
                        <div class="modal-error">@searchError</div>
                    }

                    @if (foundUser != null)
                    {
                        <div class="found-user-card">
                            <div class="found-user-avatar">
                                @if (!string.IsNullOrEmpty(foundUser.AvatarUrl))
                                {
                                    <img src="@foundUser.AvatarUrl" style="width:100%;height:100%;border-radius:50%;object-fit:cover;"/>
                                }
                                else
                                {
                                    @GetInitials(foundUser.DisplayName)
                                }
                            </div>
                            <div class="found-user-info">
                                <div class="found-user-name">@foundUser.DisplayName</div>
                                <div class="found-user-phone">@foundUser.PhoneNumber</div>
                            </div>
                            <span class="found-user-check">✓</span>
                        </div>
                    }
                }
                else
                {
                    <!-- Nhóm: tên nhóm + thêm thành viên -->
                    <div class="modal-form-group">
                        <label class="modal-label">Tên nhóm <span class="required">*</span></label>
                        <input class="modal-input" type="text" placeholder="Tên nhóm..." @bind="groupTitle" />
                    </div>

                    <div class="modal-form-group">
                        <label class="modal-label">Thêm thành viên theo SĐT</label>
                        <div class="modal-search-row">
                            <input class="modal-input"
                                   type="tel"
                                   placeholder="Nhập số điện thoại..."
                                   @bind="searchPhone"
                                   @bind:event="oninput"
                                   @onkeydown="OnSearchKeyDown" />
                            <button class="modal-search-btn" @onclick="SearchUser" disabled="@isSearching">
                                @if (isSearching) { <span class="spinner-sm"></span> } else { <span>Tìm</span> }
                            </button>
                        </div>
                    </div>

                    @if (searchError != null)
                    {
                        <div class="modal-error">@searchError</div>
                    }

                    @if (foundUser != null)
                    {
                        <div class="found-user-card">
                            <div class="found-user-avatar">
                                @if (!string.IsNullOrEmpty(foundUser.AvatarUrl))
                                {
                                    <img src="@foundUser.AvatarUrl" style="width:100%;height:100%;border-radius:50%;object-fit:cover;"/>
                                }
                                else
                                {
                                    @GetInitials(foundUser.DisplayName)
                                }
                            </div>
                            <div class="found-user-info">
                                <div class="found-user-name">@foundUser.DisplayName</div>
                                <div class="found-user-phone">@foundUser.PhoneNumber</div>
                            </div>
                            <button class="btn-add-member" @onclick="AddMember">Thêm</button>
                        </div>
                    }

                    @if (groupMembers.Any())
                    {
                        <div class="group-members-list">
                            <div class="modal-label" style="margin-bottom:8px;">Thành viên (@groupMembers.Count)</div>
                            @foreach (var m in groupMembers)
                            {
                                <div class="group-member-item">
                                    <div class="found-user-avatar" style="width:32px;height:32px;font-size:.7rem;">
                                        @if (!string.IsNullOrEmpty(m.AvatarUrl))
                                        {
                                            <img src="@m.AvatarUrl" style="width:100%;height:100%;border-radius:50%;object-fit:cover;"/>
                                        }
                                        else
                                        {
                                            @GetInitials(m.DisplayName)
                                        }
                                    </div>
                                    <span>@m.DisplayName</span>
                                    <button class="btn-remove-member" @onclick="() => groupMembers.Remove(m)">✕</button>
                                </div>
                            }
                        </div>
                    }
                }
            </div>

            @if (createError != null)
            {
                <div class="modal-error" style="margin: 0 20px 12px;">@createError</div>
            }

            <div class="modal-footer">
                <button class="modal-cancel-btn" @onclick="CloseModal">Hủy</button>
                <button class="modal-create-btn"
                        @onclick="CreateConversation"
                        disabled="@(isCreating || !CanCreate)">
                    @if (isCreating) { <span class="spinner-sm"></span> }
                    <span>Tạo cuộc trò chuyện</span>
                </button>
            </div>
        </div>
    </div>
}

<!-- ═══ MODAL HỒ SƠ (PROFILE) ═══ -->
@if (showProfileModal && conversationParticipants != null)
{
    <div class="modal-backdrop" @onclick="CloseProfileModal">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Thành viên nhóm (@conversationParticipants.Count)</h3>
                <button class="modal-close-btn" @onclick="CloseProfileModal">✕</button>
            </div>
            
            <div class="modal-body" style="padding-top: 10px; max-height: 400px; overflow-y: auto;">
                <div class="forward-list">
                    @foreach (var p in conversationParticipants)
                    {
                        <div class="forward-item" style="cursor: pointer; transition: background-color 0.2s;" @onclick="() => OpenMemberProfile(p.UserId)">
                            <div class="forward-avatar">
                                @if (!string.IsNullOrEmpty(p.AvatarUrl))
                                {
                                    <img src="@p.AvatarUrl" style="width:100%;height:100%;border-radius:50%;object-fit:cover;"/>
                                }
                                else
                                {
                                    @GetInitials(p.DisplayName)
                                }
                            </div>
                            <div class="forward-name" style="flex: 1; display: flex; flex-direction: column; gap: 2px;">
                                <span style="font-weight: 500;">@(p.DisplayName ?? "Người dùng")</span>
                                @if (!string.IsNullOrEmpty(p.PhoneNumber))
                                {
                                    <span style="font-size: 0.8rem; color: var(--text-muted);">@p.PhoneNumber</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<ChatApp.Client.Shared.UserProfileModal @ref="userProfileModal" />

@code {
    // ── Chat state ───────────────────────────────────────────
    private HubConnection? hubConnection;
    private List<MessageDto>? messages;
    private bool isLoadingMessages = false;
    private string newMessageContent = "";
    private bool isUploading = false;
    
    // ── Pinboard State ───────────────────────────────────────
    private List<PinboardItemDto> MyCanvasItems = new();
    private List<PinboardConnectionDto> MyCanvasConnections = new();

    // ── Message Features (Reply, Forward, Reaction) ─────────
    private MessageDto? replyingToMessage;
    // Trạng thái modal forward
    private bool isForwardModalOpen = false;
    private Guid? messageToForward = null;
    private List<InboxItemDto>? forwardInboxItems = null;
    private bool isForwarding = false;
    private string? forwardError;

    // Trạng thái modal Delete Conversation
    private bool showDeleteConvModal = false;
    private Guid conversationToDelete;

    // ── Toggle Pinboard ──────────────────────────────────────────
    private bool isCanvasOpen = false;

    private void ToggleCanvas()
    {
        isCanvasOpen = !isCanvasOpen;
        StateHasChanged();
    }

    // ── Inbox state ──────────────────────────────────────────
    private List<InboxItemDto>? inboxItems;
    private InboxItemDto? selectedConversation;
    private Guid selectedId;
    private bool isLoading = true;
    private string? errorMessage;
    private Guid currentUserId;

    // ── Modal state ──────────────────────────────────────────
    private bool showNewConvModal = false;
    private ConversationType convType = ConversationType.Direct;
    private string searchPhone = "";
    private bool isSearching = false;
    private string? searchError;
    private FoundUserDto? foundUser;

    // Group
    private string groupTitle = "";
    private List<FoundUserDto> groupMembers = new();

    // Create
    private bool isCreating = false;
    private string? createError;

    private bool CanCreate => convType == ConversationType.Direct
        ? foundUser != null
        : !string.IsNullOrWhiteSpace(groupTitle) && groupMembers.Any();

    // ── Layout State ─────────────────────────────────────────
    private double inboxWidth = 320;
    private bool isResizing = false;
    private double startX = 0;
    private double startWidth = 0;

    private void HandleMouseDown(MouseEventArgs e)
    {
        isResizing = true;
        startX = e.ClientX;
        startWidth = inboxWidth;
    }

    private void HandleMouseMove(MouseEventArgs e)
    {
        if (!isResizing) return;
        var diff = e.ClientX - startX;
        var newWidth = startWidth + diff;
        if (newWidth < 250) newWidth = 250; // min width
        if (newWidth > 600) newWidth = 600; // max width
        inboxWidth = newWidth;
    }

    private void HandleMouseUp(MouseEventArgs e)
    {
        isResizing = false;
    }

    // ── Profile Modal ────────────────────────────────────────
    private bool showProfileModal = false;
    private List<ParticipantProfileDto>? conversationParticipants;
    
    public class ParticipantProfileDto
    {
        public Guid UserId { get; set; }
        public string? DisplayName { get; set; }
        public string? PhoneNumber { get; set; }
        public string? AvatarUrl { get; set; }
        public string? Bio { get; set; }
    }

    private ChatApp.Client.Shared.UserProfileModal userProfileModal = default!;

    private async Task OpenProfileModal()
    {
        if (selectedConversation == null) return;
        try
        {
            var res = await Http.GetFromJsonAsync<List<ParticipantProfileDto>>($"/api/conversations/{selectedConversation.ConversationId}/participants");
            if (res != null)
            {
                if (selectedConversation.Type == ChatApp.Domain.Enums.ConversationType.Direct)
                {
                    var otherUser = res.FirstOrDefault(p => p.UserId != currentUserId);
                    if (otherUser != null)
                    {
                        if (userProfileModal != null)
                        {
                            await userProfileModal.OpenAsync(otherUser.UserId);
                        }
                    }
                }
                else
                {
                    conversationParticipants = res;
                    showProfileModal = true;
                    StateHasChanged();
                }
            }
        }
        catch
        {
            // ignore
        }
    }

    private async Task OpenMemberProfile(Guid userId)
    {
        if (userProfileModal != null)
        {
            await userProfileModal.OpenAsync(userId);
        }
    }

    private void CloseProfileModal()
    {
        showProfileModal = false;
    }

    // ── Call State ───────────────────────────────────────────
    private bool isCalling = false;
    private bool isIncomingCall = false;
    private Guid incomingCallId;
    private Guid incomingConversationId; // ← ConversationId của cuộc gọi đến (không phụ thuộc selectedId)
    private ChatApp.Domain.Enums.CallType activeCallType;
    private ChatApp.Domain.Enums.CallType incomingCallType;
    private string? incomingCallTitle;
    private Guid activeCallId;
    private Guid activeConversationId; // ← ConversationId của cuộc gọi đang active
    private bool isAudioMuted = false;
    private bool isVideoMuted = false;
    private DotNetObjectReference<Home>? objRef;
    
    // Timer
    private System.Timers.Timer? callTimer;
    private int callSeconds = 0;
    private string callTimerDisplay = "00:00";

    // ─────────────────────────────────────────────────────────
    private bool messagesRendered = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (messages != null && !isLoadingMessages && !messagesRendered)
        {
            messagesRendered = true;
            try
            {
                await JS.InvokeVoidAsync("canvasPhysics.initDraggableMessages");
            }
            catch { /* Ignore if script not loaded yet */ }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        NotificationSvc.OnNotificationClicked += HandleNotificationClicked;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userIdStr = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value 
            ?? user.FindFirst("sub")?.Value 
            ?? user.FindFirst("nameid")?.Value;
        if (!Guid.TryParse(userIdStr, out currentUserId))
        {
            Nav.NavigateTo("/login");
            return;
        }

        hubConnection = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri("/chathub"), options =>
            {
                options.AccessTokenProvider = async () =>
                {
                    var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");
                    // Blazor sessionStorage often wraps strings in quotes, remove them if present
                    return string.IsNullOrEmpty(token) ? null : token.Trim('"');
                };
            })
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<MessageDto>("ReceiveNewMessage", (message) =>
        {
            if (selectedId == message.ConversationId)
            {
                if (messages == null) messages = new List<MessageDto>();
                messages.Add(message);

                if (inboxItems != null)
                {
                    var conv = inboxItems.FirstOrDefault(c => c.ConversationId == message.ConversationId);
                    if (conv != null)
                    {
                        var updatedConv = conv with { LastMessage = message.Content ?? "Tệp đính kèm", LastMessageAt = message.CreatedAt };
                        var idx = inboxItems.IndexOf(conv);
                        if (idx != -1) inboxItems[idx] = updatedConv;
                        if (selectedConversation?.ConversationId == updatedConv.ConversationId)
                        {
                            selectedConversation = updatedConv;
                        }
                        inboxItems = inboxItems.OrderByDescending(x => x.IsPinned).ThenByDescending(x => x.LastMessageAt).ToList();
                    }
                }

                InvokeAsync(StateHasChanged);
            }
            else
            {
                InvokeAsync(LoadInbox);
                
                // Push local toast notification
                if (inboxItems != null)
                {
                    var inboxItem = inboxItems.FirstOrDefault(i => i.ConversationId == message.ConversationId);
                    if (inboxItem != null)
                    {
                        NotificationSvc.Push(new ChatApp.Client.Layout.NotificationItem
                        {
                            ConversationId = message.ConversationId,
                            ConversationTitle = inboxItem.Title ?? "Tin nhắn mới",
                            MessagePreview = message.Content ?? "Đã gửi một tệp",
                            Timestamp = message.CreatedAt
                        });
                    }
                }
            }
        });

        hubConnection.On<MessageDto>("MessageReactionUpdated", (updatedMsg) =>
        {
            if (messages != null && selectedId == updatedMsg.ConversationId)
            {
                var idx = messages.FindIndex(m => m.Id == updatedMsg.Id);
                if (idx != -1)
                {
                    messages[idx] = updatedMsg;
                    InvokeAsync(StateHasChanged);
                }
            }
        });

        // ── Call SignalR Listeners ──────────────────────────────
        hubConnection.On<Guid>("CallInitiated", (callId) =>
        {
            activeCallId = callId;
            InvokeAsync(StateHasChanged);
        });

        hubConnection.On<Guid, Guid, Guid, int>("IncomingCall", (callId, conversationId, callerId, type) =>
        {
            // Chặn duplicate nếu đã đang hiện thông báo cuộc gọi này
            if (isIncomingCall && incomingCallId == callId) return;

            incomingCallId = callId;
            incomingConversationId = conversationId; // ← Lưu đúng conversationId
            incomingCallType = (ChatApp.Domain.Enums.CallType)type;
            var conv = inboxItems?.FirstOrDefault(c => c.ConversationId == conversationId);
            incomingCallTitle = conv?.Title ?? "Ai đó";
            isIncomingCall = true;
            InvokeAsync(StateHasChanged);
        });

        hubConnection.On<Guid>("CallAccepted", async (callId) =>
        {
            if (activeCallId == callId)
            {
                if (objRef != null)
                {
                    await JS.InvokeVoidAsync("window.WebRTC.startCall");
                }
                StartCallTimer();
                InvokeAsync(StateHasChanged);
            }
        });

        hubConnection.On<Guid>("CallRejected", (callId) =>
        {
            if (activeCallId == callId)
            {
                EndCallCleanup();
            }
        });

        hubConnection.On<Guid>("CallEnded", (callId) =>
        {
            if (activeCallId == callId || incomingCallId == callId)
            {
                EndCallCleanup();
            }
        });

        hubConnection.On<string>("ReceiveWebRTCSignal", async (payload) =>
        {
            if (isCalling && objRef != null)
            {
                await JS.InvokeVoidAsync("window.WebRTC.handleSignal", payload);
            }
        });

        // ── Pinboard Listeners ──────────────────────────────────
        hubConnection.On<PinboardItemDto>("PinboardItemCreated", (item) =>
        {
            if (selectedId == item.ConversationId)
            {
                if (MyCanvasItems == null) MyCanvasItems = new();
                MyCanvasItems.Add(item);
                InvokeAsync(StateHasChanged);
            }
        });

        hubConnection.On<PinboardItemDto>("PinboardItemMoved", (item) =>
        {
            if (selectedId == item.ConversationId && MyCanvasItems != null)
            {
                var existing = MyCanvasItems.FirstOrDefault(i => i.Id == item.Id);
                if (existing != null)
                {
                    existing.PositionX = item.PositionX;
                    existing.PositionY = item.PositionY;
                    existing.ZIndex = item.ZIndex;
                    InvokeAsync(StateHasChanged);
                }
            }
        });

        hubConnection.On<Guid>("PinboardItemDeleted", (itemId) =>
        {
            if (MyCanvasItems != null)
            {
                var item = MyCanvasItems.FirstOrDefault(i => i.Id == itemId);
                if (item != null)
                {
                    MyCanvasItems.Remove(item);
                    InvokeAsync(StateHasChanged);
                }
            }
        });

        hubConnection.On<PinboardItemDto>("PinboardItemUpdated", (cmd) =>
        {
            if (MyCanvasItems != null)
            {
                var item = MyCanvasItems.FirstOrDefault(i => i.Id == cmd.Id);
                if (item != null)
                {
                    item.Content = cmd.Content;
                    InvokeAsync(StateHasChanged);
                }
            }
        });

        hubConnection.On<PinboardItemDto, Guid>("CanvasTaskCompleted", (item, taskId) =>
        {
            if (selectedId == item.ConversationId && MyCanvasItems != null)
            {
                var existing = MyCanvasItems.FirstOrDefault(i => i.Id == item.Id);
                if (existing != null)
                {
                    existing.IsCompleted = item.IsCompleted;
                    InvokeAsync(StateHasChanged);
                }
            }
        });

        hubConnection.On<PinboardConnectionDto>("PinboardConnectionCreated", (conn) =>
        {
            if (selectedId == conn.ConversationId)
            {
                if (MyCanvasConnections == null) MyCanvasConnections = new();
                MyCanvasConnections.Add(conn);
                InvokeAsync(StateHasChanged);
            }
        });

        hubConnection.On<Guid>("PinboardConnectionDeleted", (connId) =>
        {
            if (MyCanvasConnections != null)
            {
                var conn = MyCanvasConnections.FirstOrDefault(c => c.Id == connId);
                if (conn != null)
                {
                    MyCanvasConnections.Remove(conn);
                    InvokeAsync(StateHasChanged);
                }
            }
        });

        objRef = DotNetObjectReference.Create(this);

        try
        {
            await hubConnection.StartAsync();
            await LoadInbox();
        }
        catch (Exception ex)
        {
            errorMessage = "Lỗi kết nối máy chủ. Vui lòng thử đăng nhập lại.";
            // Token có thể đã hết hạn hoặc server lỗi, ép tải lại trang để middleware Auth xử lý
            if (ex.Message.Contains("401") || (ex.InnerException != null && ex.InnerException.Message.Contains("401")))
            {
                Nav.NavigateTo("/login");
            }
        }
    }

    private async Task LoadInbox()
    {
        isLoading = true;
        errorMessage = null;
        StateHasChanged();
        try
        {
            inboxItems = await Http.GetFromJsonAsync<List<InboxItemDto>>(
                $"/api/conversations/inbox/{currentUserId}");
            
            if (inboxItems != null && hubConnection != null)
            {
                foreach (var item in inboxItems)
                {
                    await hubConnection.SendAsync("JoinChatRoom", item.ConversationId.ToString());
                }
            }
        }
        catch
        {
            errorMessage = "Không thể tải danh sách tin nhắn.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task TogglePin(Guid conversationId, bool isPinned)
    {
        try
        {
            var body = new { UserId = currentUserId, IsPinned = isPinned };
            var response = await Http.PostAsJsonAsync($"/api/conversations/{conversationId}/pin", body);
            
            if (response.IsSuccessStatusCode)
            {
                if (inboxItems != null)
                {
                    var item = inboxItems.FirstOrDefault(i => i.ConversationId == conversationId);
                    if (item != null)
                    {
                        var updatedItem = item with { IsPinned = isPinned };
                        var idx = inboxItems.IndexOf(item);
                        inboxItems[idx] = updatedItem;
                        inboxItems = inboxItems.OrderByDescending(x => x.IsPinned).ThenByDescending(x => x.LastMessageAt).ToList();
                        StateHasChanged();
                    }
                }
            }
        }
        catch { }
    }

    private async Task SelectConversation(InboxItemDto item)
    {
        if (selectedId == item.ConversationId) return;

        selectedConversation = item;
        selectedId = item.ConversationId;
        messages = null;
        isLoadingMessages = true;
        messagesRendered = false; // Reset cờ render
        StateHasChanged();

        try
        {
            var msgTask = Http.GetFromJsonAsync<List<MessageDto>>($"/api/messages/{selectedId}/user/{currentUserId}");
            var canvasTask = Http.GetFromJsonAsync<List<PinboardItemDto>>($"/api/pinboard/conversation/{selectedId}");
            var connTask = Http.GetFromJsonAsync<List<PinboardConnectionDto>>($"/api/pinboard/{selectedId}/connections");
            
            await Task.WhenAll(msgTask, canvasTask, connTask);
            
            messages = msgTask.Result ?? new List<MessageDto>();
            MyCanvasItems = canvasTask.Result ?? new List<PinboardItemDto>();
            MyCanvasConnections = connTask.Result ?? new List<PinboardConnectionDto>();
        }
        catch
        {
            messages = new List<MessageDto>();
            MyCanvasItems = new List<PinboardItemDto>();
        }
        finally
        {
            isLoadingMessages = false;
            StateHasChanged();
        }
    }

    private void OpenDeleteModal(Guid conversationId)
    {
        conversationToDelete = conversationId;
        showDeleteConvModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteConvModal = false;
        conversationToDelete = Guid.Empty;
    }

    private async Task ConfirmDeleteConversation()
    {
        if (conversationToDelete == Guid.Empty) return;

        var response = await Http.DeleteAsync($"/api/conversations/{conversationToDelete}/user/{currentUserId}");
        if (response.IsSuccessStatusCode)
        {
            selectedId = Guid.Empty;
            selectedConversation = null;
            messages = null;
            await LoadInbox();
        }
        
        CloseDeleteModal();
    }

    // ── Modal ────────────────────────────────────────────────
    private void OpenNewConvModal()
    {
        showNewConvModal = true;
        convType = ConversationType.Direct;
        searchPhone = "";
        foundUser = null;
        searchError = null;
        groupTitle = "";
        groupMembers = new();
        createError = null;
    }

    private void CloseModal() => showNewConvModal = false;

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchUser();
    }

    private async Task SearchUser()
    {
        if (string.IsNullOrWhiteSpace(searchPhone)) return;
        isSearching = true;
        searchError = null;
        foundUser = null;
        StateHasChanged();
        try
        {
            var resp = await Http.GetAsync($"/api/users/search?phone={Uri.EscapeDataString(searchPhone.Trim())}");
            if (resp.IsSuccessStatusCode)
            {
                foundUser = await resp.Content.ReadFromJsonAsync<FoundUserDto>();
            }
            else
            {
                searchError = "Không tìm thấy người dùng với số điện thoại này.";
            }
        }
        catch
        {
            searchError = "Lỗi kết nối. Vui lòng thử lại.";
        }
        finally
        {
            isSearching = false;
            StateHasChanged();
        }
    }

    private void AddMember()
    {
        if (foundUser == null) return;
        if (foundUser.Id == currentUserId) { searchError = "Không thể thêm chính bạn."; return; }
        if (groupMembers.Any(m => m.Id == foundUser.Id)) { searchError = "Người này đã được thêm."; return; }
        groupMembers.Add(foundUser);
        foundUser = null;
        searchPhone = "";
        searchError = null;
    }

    private async Task CreateConversation()
    {
        isCreating = true;
        createError = null;
        StateHasChanged();
        try
        {
            List<Guid> participantIds;
            string? title;

            if (convType == ConversationType.Direct)
            {
                participantIds = new List<Guid> { foundUser!.Id };
                title = foundUser.DisplayName;
            }
            else
            {
                participantIds = groupMembers.Select(m => m.Id).ToList();
                title = groupTitle.Trim();
            }

            var body = new
            {
                CreatorId = currentUserId,
                Title = title,
                Type = (int)convType,
                ParticipantIds = participantIds
            };

            var resp = await Http.PostAsJsonAsync("/api/conversations", body);
            if (resp.IsSuccessStatusCode)
            {
                var newConvId = await resp.Content.ReadFromJsonAsync<Guid>();
                CloseModal();
                await LoadInbox();
                
                if (inboxItems != null)
                {
                    var itemToSelect = inboxItems.FirstOrDefault(i => i.ConversationId == newConvId);
                    if (itemToSelect != null)
                    {
                        await SelectConversation(itemToSelect);
                    }
                }
            }
            else
            {
                createError = "Không thể tạo cuộc trò chuyện. Vui lòng thử lại.";
            }
        }
        catch
        {
            createError = "Lỗi kết nối. Vui lòng thử lại.";
        }
        finally
        {
            isCreating = false;
            StateHasChanged();
        }
    }

    // ── Helpers ──────────────────────────────────────────────
    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
        return name.Length >= 2 ? name[..2].ToUpper() : name.ToUpper();
    }

    private string FormatTime(DateTime? dt)
    {
        if (dt == null) return "";
        var local = dt.Value.ToLocalTime();
        var now = DateTime.Now;
        if (local.Date == now.Date) return local.ToString("HH:mm");
        if (local.Date == now.Date.AddDays(-1)) return "Hôm qua";
        return local.ToString("dd/MM");
    }

    private string TruncateMessage(string? msg)
    {
        if (string.IsNullOrEmpty(msg)) return "";
        return msg.Length > 40 ? msg[..40] + "..." : msg;
    }

    // ── Chat logic ───────────────────────────────────────────
    private async Task TriggerFileInput()
    {
        await JS.InvokeVoidAsync("eval", "document.getElementById('chatFileInput').click()");
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null || selectedId == Guid.Empty || hubConnection == null) return;

        isUploading = true;
        StateHasChanged();

        try
        {
            var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");
            token = token?.Trim('"');

            using var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024)); // max 20MB
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(fileContent, "file", file.Name);

            var request = new HttpRequestMessage(HttpMethod.Post, "/api/attachments/upload")
            {
                Content = content
            };
            if (!string.IsNullOrEmpty(token))
            {
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<UploadResponse>();
                if (result != null && !string.IsNullOrEmpty(result.Url))
                {
                    bool isImage = file.ContentType.StartsWith("image/");
                    var command = new
                    {
                        ConversationId = selectedId,
                        SenderId = currentUserId,
                        MessageType = isImage ? MessageType.Image : MessageType.File,
                        Content = isImage ? "Đã gửi một ảnh" : file.Name,
                        AttachmentUrl = result.Url,
                        AttachmentName = result.OriginalName,
                        AttachmentContentType = result.ContentType,
                        AttachmentSize = result.Size,
                        ReplyToMessageId = replyingToMessage?.Id
                    };
                    await hubConnection.SendAsync("SendMessage", command);
                }
            }
        }
        catch
        {
            // Xử lý lỗi upload
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

    private async Task OnMessageKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(newMessageContent) || selectedId == Guid.Empty || hubConnection == null)
            return;

        var content = newMessageContent.Trim();
        newMessageContent = "";
        StateHasChanged();

        try
        {
            var command = new
            {
                ConversationId = selectedId,
                SenderId = currentUserId,
                MessageType = MessageType.Text,
                Content = content,
                ReplyToMessageId = replyingToMessage?.Id
            };
            ClearReply();
            await hubConnection.SendAsync("SendMessage", command);
        }
        catch
        {
            // Failed to send
        }
    }

