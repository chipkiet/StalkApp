@page "/"
@attribute [Authorize]
@using ChatApp.Application.DTOs.Conversations
@using ChatApp.Application.DTOs.Messages
@using ChatApp.Domain.Enums
@using ChatApp.Shared.DTOs.Pinboard
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject AuthenticationStateProvider AuthStateProvider
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ChatApp.Client.Layout.NotificationService NotificationSvc

<PageTitle>Tin nhắn – STALKchat</PageTitle>

<div class="chat-shell" @onmousemove="HandleMouseMove" @onmouseup="HandleMouseUp" @onmouseleave="HandleMouseUp" style="@(isResizing ? "cursor: col-resize; user-select: none;" : "")">

    <!-- ═══ CỘT TRÁI: INBOX LIST ═══ -->
    <div class="inbox-panel" style="width: @(inboxWidth)px; position: relative;">
        <div class="inbox-header">
            <h2 class="inbox-title">Tin nhắn</h2>
            <button class="inbox-new-btn" title="Tạo cuộc trò chuyện mới" @onclick="OpenNewConvModal"><Icon Name="plus" Size="16" /></button>
        </div>

        @if (isLoading)
        {
            @for (int i = 0; i < 5; i++)
            {
                <div class="conversation-skeleton">
                    <div class="skel-avatar"></div>
                    <div class="skel-lines">
                        <div class="skel-line skel-line-title"></div>
                        <div class="skel-line skel-line-sub"></div>
                    </div>
                </div>
            }
        }
        else if (errorMessage != null)
        {
            <div class="inbox-error">
                <span><Icon Name="alert" Size="24" /></span>
                <p>@errorMessage</p>
                <button class="btn-retry" @onclick="LoadInbox">Thử lại</button>
            </div>
        }
        else if (inboxItems == null || !inboxItems.Any())
        {
            <div class="inbox-empty">
                <div class="inbox-empty-icon"><Icon Name="message" Size="24" /></div>
                <p>Chưa có cuộc trò chuyện nào</p>
                <span>Nhấn <strong><Icon Name="plus" Size="16" /></strong> để bắt đầu</span>
            </div>
        }
        else
        {
            <div class="conversation-list">
                @foreach (var item in inboxItems)
                {
                    <div class="conversation-item @(selectedId == item.ConversationId ? "active" : "")"
                         @onclick="() => SelectConversation(item)">
                        <div class="conv-avatar">
                            @if (!string.IsNullOrEmpty(item.AvatarUrl))
                            {
                                <img src="@item.AvatarUrl" style="width:100%;height:100%;border-radius:50%;object-fit:cover;"/>
                            }
                            else
                            {
                                @GetInitials(item.Title)
                            }
                        </div>
                        <div class="conv-info">
                            <div class="conv-top" style="display: flex; justify-content: space-between; align-items: center;">
                                <span class="conv-name" style="display: flex; align-items: center; gap: 4px;">
                                    @if (item.IsPinned) { <span title="Đã ghim"><Icon Name="pin" Size="14" /></span> }
                                    @(item.Title ?? "Cuộc trò chuyện")
                                </span>
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <button class="btn-pin-conv" style="background: none; border: none; cursor: pointer; padding: 0; font-size: 0.9rem; opacity: 0.5;"
                                            @onclick:stopPropagation="true" 
                                            @onclick="() => TogglePin(item.ConversationId, !item.IsPinned)" 
                                            title="@(item.IsPinned ? "Bỏ ghim" : "Ghim hội thoại")">
                                        <Icon Name="@(item.IsPinned ? "pin" : "pin-off")" Size="14" />
                                    </button>
                                    <span class="conv-time">@FormatTime(item.LastMessageAt)</span>
                                </div>
                            </div>
                            <div class="conv-bottom">
                                <span class="conv-preview">@TruncateMessage(item.LastMessage)</span>
                                @if (item.UnreadCount > 0)
                                {
                                    <span class="conv-badge">@(item.UnreadCount > 99 ? "99+" : item.UnreadCount.ToString())</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        
        <!-- Thanh kéo (Resizer) nằm đè lên viền phải cột trái -->
        <div class="layout-resizer" @onmousedown="HandleMouseDown" @onmousedown:preventDefault="true" @onmousedown:stopPropagation="true"></div>
    </div>

    <!-- ═══ CỘT PHẢI: VÙNG CHAT ═══ -->
    <div class="chat-panel">
        @if (selectedConversation == null)
        {
            <div class="chat-placeholder">
                <div class="placeholder-logo">
                    <div class="placeholder-logo-s">S</div>
                    <div class="placeholder-logo-text">STALK</div>
                </div>
                <p class="placeholder-title">Chào mừng đến với STALKchat</p>
                <p class="placeholder-sub">Chọn một cuộc trò chuyện hoặc nhấn <strong><Icon Name="plus" Size="16" /></strong> để bắt đầu</p>
            </div>
        }
        else
        {
            <div class="chat-header">
                <div class="chat-header-clickable" @onclick="OpenProfileModal" style="display: flex; align-items: center; gap: 12px; cursor: pointer; flex-grow: 1;">
                    <div class="chat-header-avatar">
                        @if (!string.IsNullOrEmpty(selectedConversation.AvatarUrl))
                        {
                            <img src="@selectedConversation.AvatarUrl" style="width:100%;height:100%;border-radius:50%;object-fit:cover;"/>
                        }
                        else
                        {
                            @GetInitials(selectedConversation.Title)
                        }
                    </div>
                    <div class="chat-header-info">
                        <div class="chat-header-name">@(selectedConversation.Title ?? "Cuộc trò chuyện")</div>
                        <div class="chat-header-status">STALKchat</div>
                    </div>
                </div>
                <div class="chat-header-actions">
                    @{
                        bool isMuted = selectedConversation.IsMuted;
                        <button class="btn-call" title="@(isMuted ? "Bật thông báo" : "Tắt thông báo")"
                                @onclick="() => ToggleMute(selectedConversation)">
                            <Icon Name="@(isMuted ? "bell-off" : "bell")" Size="18" />
                        </button>
                    }
                    <button class="btn-call" title="Bảng Công Việc (Pinboard)" @onclick="ToggleCanvas" style="@(isCanvasOpen ? "color: var(--accent);" : "")">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="7.5 4.21 12 6.81 16.5 4.21"></polyline><polyline points="7.5 19.79 7.5 14.6 3 12"></polyline><polyline points="21 12 16.5 14.6 16.5 19.79"></polyline><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                    </button>
                    <button class="btn-call" title="Gọi thoại" @onclick="() => InitiateCall(false)"><Icon Name="phone" Size="18" /></button>
                    <button class="btn-call" title="Gọi video" @onclick="() => InitiateCall(true)"><Icon Name="video" Size="18" /></button>
                    <button class="btn-call" style="color: #ff4d4f;" title="Xóa cuộc trò chuyện" @onclick="() => OpenDeleteModal(selectedConversation.ConversationId)"><Icon Name="trash" Size="18" /></button>
                </div>
            </div>
            <div class="chat-messages-area" id="chat-messages-area">
                @if (isLoadingMessages)
                {
                    <div class="chat-loading" style="text-align: center; margin-top: 20px; color: var(--text-muted);">
                        <span class="spinner-sm" style="border-color: var(--accent); border-top-color: transparent;"></span>
                        <span style="margin-left: 8px;">Đang tải tin nhắn...</span>
                    </div>
                }
                else if (messages != null && messages.Any())
                {
                    <div class="chat-message-list">
                        @foreach (var msg in messages)
                        {
                            bool isSystem = msg.MessageType == MessageType.System;
                            bool isSelf = msg.SenderId == currentUserId;
                            string msgClass = isSystem ? "msg-system" : (isSelf ? "msg-self" : "msg-other");
                            <div class="chat-msg @msgClass">
                                @if (isSystem)
                                {
                                    // Không render avatar hay action cho tin nhắn hệ thống
                                }
                                else if (isSelf)
                                {
                                    <div class="msg-actions">
                                        <button class="btn-msg-action" title="Trả lời" @onclick="() => SetReply(msg)"><Icon Name="reply" Size="16" /></button>
                                        <button class="btn-msg-action" title="Chuyển tiếp" @onclick="() => OpenForwardModal(msg.Id)"><Icon Name="forward" Size="16" /></button>
                                    </div>
                                }
                                else
                                {
                                    <div class="msg-avatar">
                                        @if (!string.IsNullOrEmpty(selectedConversation?.AvatarUrl))
                                        {
                                            <img src="@selectedConversation.AvatarUrl" style="width:100%;height:100%;border-radius:50%;object-fit:cover;"/>
                                        }
                                        else
                                        {
                                            @GetInitials(selectedConversation?.Title)
                                        }
                                    </div>
                                }
                                <div class="msg-content-wrapper">
                                    <div class="msg-bubble chat-bubble draggable" data-msg-id="@msg.Id">
                                        @if (msg.ReplyTo != null)
                                        {
                                            <div class="msg-quoted">
                                                <div class="quoted-author">Đã trả lời</div>
                                                <div class="quoted-content">@TruncateMessage(msg.ReplyTo.Content ?? "Tệp đính kèm")</div>
                                            </div>
                                        }
                                        @if (msg.MessageType == MessageType.Image && !string.IsNullOrEmpty(msg.AttachmentUrl))
                                        {
                                            <img src="@msg.AttachmentUrl" class="msg-image" alt="image" />
                                        }
                                        else if (msg.MessageType == MessageType.File && !string.IsNullOrEmpty(msg.AttachmentUrl))
                                        {
                                            <a href="@msg.AttachmentUrl" target="_blank" class="msg-file">
                                                <span><Icon Name="file" Size="16" /></span> @(msg.AttachmentName ?? "File đính kèm")
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="msg-content">@msg.Content</span>
                                        }
                                    </div>
                                    @if (msg.Reactions != null && msg.Reactions.Any())
                                    {
                                        <div class="msg-reactions">
                                            @foreach (var r in msg.Reactions.GroupBy(x => x.Emotion))
                                            {
                                                <span class="reaction-badge" title="Đã thả cảm xúc">@r.Key @r.Count()</span>
                                            }
                                        </div>
                                    }
                                    <span class="msg-time">@msg.CreatedAt.ToLocalTime().ToString("HH:mm")</span>
                                </div>
                                @if (!isSelf && !isSystem)
                                {
                                    <div class="msg-actions">
                                        <div class="reaction-picker-wrapper">
                                            <button class="btn-msg-action btn-react" title="Thả cảm xúc"><Icon Name="smile" Size="16" /></button>
                                            <div class="reaction-picker">
                                                <button @onclick='() => AddReaction(msg.Id, "👍")'>👍</button>
                                                <button @onclick='() => AddReaction(msg.Id, "❤️")'>❤️</button>
                                                <button @onclick='() => AddReaction(msg.Id, "😂")'>😂</button>
                                                <button @onclick='() => AddReaction(msg.Id, "😲")'>😲</button>
                                                <button @onclick='() => AddReaction(msg.Id, "😢")'>😢</button>
                                                <button @onclick='() => AddReaction(msg.Id, "😡")'>😡</button>
                                            </div>
                                        </div>
                                        <button class="btn-msg-action" title="Trả lời" @onclick="() => SetReply(msg)"><Icon Name="reply" Size="16" /></button>
                                        <button class="btn-msg-action" title="Chuyển tiếp" @onclick="() => OpenForwardModal(msg.Id)"><Icon Name="forward" Size="16" /></button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="chat-empty" style="text-align: center; margin-top: 40px; color: var(--text-muted);">
                        <p>Chưa có tin nhắn nào. Hãy bắt đầu cuộc trò chuyện!</p>
                    </div>
                }
            </div>

            @if (isUploading)
            {
                <div style="padding: 4px 16px; font-size: 0.8rem; color: var(--text-muted); background: var(--bg-main);">
                    <span class="spinner-sm" style="border-color: var(--text-muted); border-top-color: transparent; width: 10px; height: 10px; display: inline-block;"></span>
                    Đang tải file lên...
                </div>
            }

            @if (replyingToMessage != null)
            {
                <div class="reply-indicator">
                    <div class="reply-info">
                        <span class="reply-title">Đang trả lời tin nhắn</span>
                        <span class="reply-text">@TruncateMessage(replyingToMessage.Content ?? "Tệp đính kèm")</span>
                    </div>
                    <button class="btn-cancel-reply" @onclick="ClearReply" title="Hủy trả lời"><Icon Name="x" Size="16" /></button>
                </div>
            }

            <div class="chat-input-area" style="position: relative;">
                @if (showMentionPopup && mentionCandidates != null && mentionCandidates.Any())
                {
                    <div class="mention-dropdown">
                        @foreach (var p in mentionCandidates)
                        {
                            <div class="mention-item" @onclick="() => InsertMention(p)">
                                <div class="mention-item-avatar">
                                    @if (!string.IsNullOrEmpty(p.AvatarUrl))
                                    {
                                        <img src="@p.AvatarUrl" style="width:100%;height:100%;border-radius:50%;object-fit:cover;"/>
                                    }
                                    else
                                    {
                                        @GetInitials(p.DisplayName)
                                    }
                                </div>
                                <div class="mention-item-name">@p.DisplayName</div>
                            </div>
                        }
                    </div>
                }
                <button class="btn-attach" @onclick="TriggerFileInput" title="Đính kèm file/ảnh">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path></svg>
                </button>
                <InputFile OnChange="HandleFileSelected" class="file-input-hidden" id="chatFileInput" />
                
                <input class="chat-input"
                       type="text"
                       placeholder="Nhập tin nhắn..."
                       value="@newMessageContent"
                       @oninput="HandleChatInput"
                       @onkeydown="OnMessageKeyDown" />
                <button class="btn-schedule" @onclick="OpenSchedulePopup" title="Đặt giờ gửi" style="background:none; border:none; cursor:pointer; font-size:1.2rem; margin-right:8px; opacity:0.8; transition:opacity 0.2s;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.8'"><Icon Name="clock" Size="18" /></button>
                <button class="chat-send-btn" 
                        @onclick="SendMessage" 
                        disabled="@(string.IsNullOrWhiteSpace(newMessageContent) && !isUploading)">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                </button>
            </div>
        }
    </div>

    <!-- ═══ CỘT PHẢI: CANVAS PINBOARD ═══ -->
    <div class="canvas-panel @(isCanvasOpen ? "open" : "closed")">
        <ChatApp.Client.Components.Pinboard.CanvasBoard 
            Items="@MyCanvasItems" 
            Connections="@MyCanvasConnections"
            ActiveCursors="@activeCursors"
            OnItemCreatedFromDrop="HandleItemCreatedFromDrop"
            OnItemMoved="HandleItemMoved" 
            OnItemMovedLive="HandleItemMovedLive"
            OnCursorMovedEvent="HandleCursorMoved"
            OnTaskCompleted="HandleTaskCompleted" 
            OnItemDeleted="HandleItemDeleted"
            OnItemContentUpdated="HandleItemContentUpdated"
            OnConnectionCreated="HandleConnectionCreated"
                          OnConnectionDeleted="HandleConnectionDeleted" />
    </div>
</div>

<!-- ═══ MODAL CUỘC GỌI ĐẾN (INCOMING CALL) ═══ -->
@if (isIncomingCall)
{
    <div class="modal-backdrop">
        <div class="call-incoming-box">
            <div class="call-incoming-avatar">@GetInitials(incomingCallTitle)</div>
            <h3>@(incomingCallTitle) đang gọi...</h3>
            <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 20px;">
                @(incomingCallType == ChatApp.Domain.Enums.CallType.Video ? "Cuộc gọi Video" : "Cuộc gọi thoại")
            </p>
            <div class="call-incoming-actions">
                <button class="btn-reject-call" @onclick="RejectCall">
                    <span style="transform: rotate(135deg); display: inline-block;"><Icon Name="phone" Size="18" /></span>
                </button>
                <button class="btn-accept-call" @onclick="AcceptCall">
                    <Icon Name="phone" Size="18" />
                </button>
            </div>
        </div>
    </div>
}

<!-- ═══ MÀN HÌNH ĐANG GỌI (ACTIVE CALL OVERLAY) ═══ -->
@if (isCalling)
{
    <div class="call-overlay @(activeCallType == ChatApp.Domain.Enums.CallType.Video ? "call-video-mode" : "call-audio-mode")">
        @if (activeCallType == ChatApp.Domain.Enums.CallType.Video)
        {
            <div class="video-container">
                <video id="remoteVideo" autoplay playsinline></video>
                <video id="localVideo" autoplay playsinline muted></video>
            </div>
        }
        else
        {
            <div class="audio-call-container">
                <div class="call-incoming-avatar" style="width: 120px; height: 120px; font-size: 3rem;">
                    @GetInitials(incomingCallTitle ?? selectedConversation?.Title)
                </div>
                <h2>Đang gọi thoại...</h2>
                <div class="call-timer">@callTimerDisplay</div>
            </div>
            <!-- Ẩn thẻ video khi gọi thoại để WebRTC vẫn có nơi gắn stream -->
            <div style="display: none;">
                <video id="remoteVideo" autoplay playsinline></video>
                <video id="localVideo" autoplay playsinline muted></video>
            </div>
        }

        <div class="call-controls">
            <button class="btn-call-control @(isAudioMuted ? "muted" : "")" @onclick="ToggleAudio" title="Tắt/Bật Mic">
                <Icon Name="@(isAudioMuted ? "mic-off" : "mic")" Size="18" />
            </button>
            @if (activeCallType == ChatApp.Domain.Enums.CallType.Video)
            {
                <button class="btn-call-control @(isVideoMuted ? "muted" : "")" @onclick="ToggleVideo" title="Tắt/Bật Camera">
                    <Icon Name="@(isVideoMuted ? "video-off" : "camera")" Size="18" />
                </button>
            }
            <button class="btn-call-control btn-end-call" @onclick="EndCall" title="Kết thúc">
                <span style="transform: rotate(135deg); display: inline-block;"><Icon Name="phone" Size="18" /></span>
            </button>
        </div>
    </div>
}

<!-- ═══ MODAL XÓA CUỘC TRÒ CHUYỆN ═══ -->
@if (showDeleteConvModal)
{
    <div class="modal-backdrop" @onclick="CloseDeleteModal">
        <div class="modal-box" @onclick:stopPropagation="true" style="max-width: 400px; text-align: center; padding: 24px;">
            <div style="font-size: 3.5rem; margin-bottom: 12px;"><Icon Name="trash" Size="18" /></div>
            <h3 style="margin-bottom: 12px; font-size: 1.25rem;">Xóa cuộc trò chuyện?</h3>
            <p style="font-size: 0.95rem; color: var(--text-muted); margin-bottom: 24px; line-height: 1.5;">
                Bạn có chắc chắn muốn xóa cuộc trò chuyện này không?<br/>
                Người kia vẫn sẽ nhìn thấy cuộc trò chuyện.
            </p>
            <div style="display: flex; gap: 12px; justify-content: center;">
                <button class="btn-cancel" style="flex: 1; padding: 10px; border-radius: 8px; border: none; background: #3a3b3c; color: white; cursor: pointer; font-weight: 500;" @onclick="CloseDeleteModal">Hủy</button>
                <button class="btn-confirm-delete" style="flex: 1; padding: 10px; border-radius: 8px; border: none; background: #ff4d4f; color: white; cursor: pointer; font-weight: 500;" @onclick="ConfirmDeleteConversation">Xóa</button>
            </div>
        </div>
    </div>
}

<!-- ═══ MODAL CHUYỂN TIẾP TIN NHẮN ═══ -->
@if (isForwardModalOpen)
{
    <div class="modal-backdrop" @onclick="CloseForwardModal">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Chuyển tiếp tin nhắn</h3>
                <button class="modal-close-btn" @onclick="CloseForwardModal"><Icon Name="x" Size="16" /></button>
            </div>
            <div class="modal-body" style="padding-top: 10px;">
                <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 10px;">Chọn đoạn chat để chuyển tiếp:</p>
                
                @if (forwardInboxItems == null || !forwardInboxItems.Any())
                {
                    <p style="text-align: center; color: var(--text-muted); font-size: 0.85rem;">Không có cuộc trò chuyện nào khác.</p>
                }
                else
                {
                    <div class="forward-list">
                        @foreach (var item in forwardInboxItems)
                        {
                            <div class="forward-item">
                                <div class="forward-avatar">
                                    @if (!string.IsNullOrEmpty(item.AvatarUrl))
                                    {
                                        <img src="@item.AvatarUrl" style="width:100%;height:100%;border-radius:50%;object-fit:cover;"/>
                                    }
                                    else
                                    {
                                        @GetInitials(item.Title)
                                    }
                                </div>
                                <div class="forward-name">@(item.Title ?? "Cuộc trò chuyện")</div>
                                <button class="btn-forward-send" @onclick="() => ForwardMessage(item.ConversationId)" disabled="@isForwarding">Gửi</button>
                            </div>
                        }
                    </div>
                }
            </div>
            @if (forwardError != null)
            {
                <div class="modal-error" style="margin: 0 20px 12px;">@forwardError</div>
            }
        </div>
    </div>
}

<!-- ═══ MODAL TẠO CUỘC TRÒ CHUYỆN MỚI ═══ -->
@if (showNewConvModal)
{
    <div class="modal-backdrop" @onclick="CloseModal">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Cuộc trò chuyện mới</h3>
                <button class="modal-close-btn" @onclick="CloseModal"><Icon Name="x" Size="16" /></button>
            </div>

            <!-- Tab chọn loại -->
            <div class="modal-tabs">
                <button class="modal-tab @(convType == ConversationType.Direct ? "active" : "")"
                        @onclick='() => convType = ConversationType.Direct'>
                    <Icon Name="user" Size="18" /> Tin nhắn trực tiếp
                </button>
                <button class="modal-tab @(convType == ConversationType.Group ? "active" : "")"
                        @onclick='() => convType = ConversationType.Group'>
                    <Icon Name="users" Size="18" /> Tạo nhóm
                </button>
            </div>

            <div class="modal-body">
                @if (convType == ConversationType.Direct)
                {
                    <!-- Tìm user theo SĐT -->
                    <div class="modal-form-group">
                        <label class="modal-label">Tìm theo số điện thoại</label>
                        <div class="modal-search-row">
                            <input class="modal-input"
                                   type="tel"
                                   placeholder="Nhập số điện thoại..."
                                   @bind="searchPhone"
                                   @bind:event="oninput"
                                   @onkeydown="OnSearchKeyDown" />
                            <button class="modal-search-btn" @onclick="SearchUser" disabled="@isSearching">
                                @if (isSearching) { <span class="spinner-sm"></span> } else { <span>Tìm</span> }
                            </button>
                        </div>
                    </div>

                    @if (searchError != null)
                    {
                        <div class="modal-error">@searchError</div>
                    }

                    @if (foundUser != null)
                    {
                        <div class="found-user-card">
                            <div class="found-user-avatar">
                                @if (!string.IsNullOrEmpty(foundUser.AvatarUrl))
                                {
                                    <img src="@foundUser.AvatarUrl" style="width:100%;height:100%;border-radius:50%;object-fit:cover;"/>
                                }
                                else
                                {
                                    @GetInitials(foundUser.DisplayName)
                                }
                            </div>
                            <div class="found-user-info">
                                <div class="found-user-name">@foundUser.DisplayName</div>
                                <div class="found-user-phone">@foundUser.PhoneNumber</div>
                            </div>
                            <span class="found-user-check">✓</span>
                        </div>
                    }
                }
                else
                {
                    <!-- Nhóm: tên nhóm + thêm thành viên -->
                    <div class="modal-form-group">
                        <label class="modal-label">Tên nhóm <span class="required">*</span></label>
                        <input class="modal-input" type="text" placeholder="Tên nhóm..." @bind="groupTitle" />
                    </div>

                    <div class="modal-form-group">
                        <label class="modal-label">Thêm thành viên theo SĐT</label>
                        <div class="modal-search-row">
                            <input class="modal-input"
                                   type="tel"
                                   placeholder="Nhập số điện thoại..."
                                   @bind="searchPhone"
                                   @bind:event="oninput"
                                   @onkeydown="OnSearchKeyDown" />
                            <button class="modal-search-btn" @onclick="SearchUser" disabled="@isSearching">
                                @if (isSearching) { <span class="spinner-sm"></span> } else { <span>Tìm</span> }
                            </button>
                        </div>
                    </div>

                    @if (searchError != null)
                    {
                        <div class="modal-error">@searchError</div>
                    }

                    @if (foundUser != null)
                    {
                        <div class="found-user-card">
                            <div class="found-user-avatar">
                                @if (!string.IsNullOrEmpty(foundUser.AvatarUrl))
                                {
                                    <img src="@foundUser.AvatarUrl" style="width:100%;height:100%;border-radius:50%;object-fit:cover;"/>
                                }
                                else
                                {
                                    @GetInitials(foundUser.DisplayName)
                                }
                            </div>
                            <div class="found-user-info">
                                <div class="found-user-name">@foundUser.DisplayName</div>
                                <div class="found-user-phone">@foundUser.PhoneNumber</div>
                            </div>
                            <button class="btn-add-member" @onclick="AddMember">Thêm</button>
                        </div>
                    }

                    @if (groupMembers.Any())
                    {
                        <div class="group-members-list">
                            <div class="modal-label" style="margin-bottom:8px;">Thành viên (@groupMembers.Count)</div>
                            @foreach (var m in groupMembers)
                            {
                                <div class="group-member-item">
                                    <div class="found-user-avatar" style="width:32px;height:32px;font-size:.7rem;">
                                        @if (!string.IsNullOrEmpty(m.AvatarUrl))
                                        {
                                            <img src="@m.AvatarUrl" style="width:100%;height:100%;border-radius:50%;object-fit:cover;"/>
                                        }
                                        else
                                        {
                                            @GetInitials(m.DisplayName)
                                        }
                                    </div>
                                    <span>@m.DisplayName</span>
                                    <button class="btn-remove-member" @onclick="() => groupMembers.Remove(m)"><Icon Name="x" Size="16" /></button>
                                </div>
                            }
                        </div>
                    }
                }
            </div>

            @if (createError != null)
            {
                <div class="modal-error" style="margin: 0 20px 12px;">@createError</div>
            }

            <div class="modal-footer">
                <button class="modal-cancel-btn" @onclick="CloseModal">Hủy</button>
                <button class="modal-create-btn"
                        @onclick="CreateConversation"
                        disabled="@(isCreating || !CanCreate)">
                    @if (isCreating) { <span class="spinner-sm"></span> }
                    <span>Tạo cuộc trò chuyện</span>
                </button>
            </div>
        </div>
    </div>
}

<!-- ═══ MODAL HỒ SƠ NHÓM (GROUP PROFILE) ═══ -->
@if (showProfileModal && conversationParticipants != null)
{
    <div class="modal-backdrop" @onclick="CloseProfileModal">
        <div class="modal-box group-profile-modal" @onclick:stopPropagation="true" style="max-width:480px; width:95%; padding:0; overflow:hidden;">

            <!-- Header -->
            <div style="background: var(--surface); padding: 28px 24px 20px; position: relative; border-bottom: 1px solid var(--border);">
                <button class="modal-close-btn" @onclick="CloseProfileModal"
                        style="position:absolute; top:12px; right:12px; background:var(--hover-bg); color:var(--text-muted); border:none; border-radius:50%; width:30px; height:30px; cursor:pointer; font-size:1rem;"><Icon Name="x" Size="16" /></button>

                <!-- Group Avatar -->
                <div style="display:flex; flex-direction:column; align-items:center; gap:10px;">
                    <div style="position:relative; width:80px; height:80px;">
                        <div style="width:80px; height:80px; border-radius:50%; background:var(--hover-bg); display:flex; align-items:center; justify-content:center; font-size:1.8rem; font-weight:700; color:var(--text-primary); overflow:hidden; border:3px solid var(--border);">
                            @if (!string.IsNullOrEmpty(selectedConversation?.AvatarUrl))
                            {
                                <img src="@selectedConversation.AvatarUrl" style="width:100%;height:100%;object-fit:cover;"/>
                            }
                            else
                            {
                                @GetInitials(selectedConversation?.Title)
                            }
                        </div>
                        <label title="Đổi ảnh nhóm" style="position:absolute; bottom:0; right:0; width:26px; height:26px; border-radius:50%; background:var(--surface); border:2px solid var(--accent); display:flex; align-items:center; justify-content:center; cursor:pointer; font-size:0.8rem; color:var(--text-primary);">
                            <Icon Name="camera" Size="18" />
                            <InputFile OnChange="HandleGroupAvatarChange" style="display:none;" accept="image/*" />
                        </label>
                    </div>

                    <!-- Editable Group Name -->
                    @if (isEditingGroupName)
                    {
                        <div style="display:flex; gap:6px; align-items:center;">
                            <input @bind="editGroupName" style="background:var(--hover-bg); border:1px solid var(--border); border-radius:8px; padding:4px 10px; color:var(--text-primary); font-size:1rem; text-align:center; outline:none; width:200px;"
                                   placeholder="Tên nhóm..." />
                            <button @onclick="SaveGroupName" style="background:var(--accent); border:none; border-radius:6px; padding:5px 10px; color:#fff; cursor:pointer; font-size:0.85rem;">✓</button>
                            <button @onclick='() => { isEditingGroupName = false; }' style="background:var(--hover-bg); border:1px solid var(--border); border-radius:6px; padding:5px 10px; color:var(--text-muted); cursor:pointer; font-size:0.85rem;"><Icon Name="x" Size="16" /></button>
                        </div>
                    }
                    else
                    {
                        <div style="display:flex; align-items:center; gap:8px;">
                            <span style="color:var(--text-primary); font-size:1.15rem; font-weight:600;">@(selectedConversation?.Title ?? "Nhóm chat")</span>
                            <button @onclick='() => { editGroupName = selectedConversation?.Title ?? ""; isEditingGroupName = true; }'
                                    title="Sửa tên nhóm" style="background:var(--hover-bg); border:1px solid var(--border); border-radius:50%; width:24px; height:24px; display:flex; align-items:center; justify-content:center; cursor:pointer; color:var(--text-primary); font-size:0.7rem;"><Icon Name="edit" Size="14" /></button>
                        </div>
                    }
                    <span style="color:var(--text-muted); font-size:0.85rem;">@conversationParticipants.Count thành viên</span>
                </div>
            </div>

            <!-- Body -->
            <div style="padding: 16px 20px; max-height: 380px; overflow-y: auto;">

                <!-- Thêm thành viên -->
                @if (!showAddMemberPanel)
                {
                    <button @onclick="OpenAddMemberPanel"
                            style="width:100%; padding:10px; background:var(--bg-card); border:1px dashed var(--border); border-radius:10px; color:var(--accent); cursor:pointer; font-size:0.9rem; display:flex; align-items:center; justify-content:center; gap:8px; margin-bottom:14px; transition: background 0.2s;">
                        ➕ Thêm thành viên
                    </button>
                }
                else
                {
                    <div style="background:var(--bg-card); border-radius:10px; padding:14px; margin-bottom:14px; border:1px solid var(--border);">
                        <div style="font-weight:600; font-size:0.9rem; margin-bottom:10px; display:flex; justify-content:space-between; align-items:center;">
                            <span>Chọn bạn bè để thêm</span>
                            <button @onclick='() => { showAddMemberPanel = false; selectedFriendIds.Clear(); }'
                                    style="background:none; border:none; cursor:pointer; color:var(--text-muted); font-size:0.9rem;"><Icon Name="x" Size="16" /></button>
                        </div>
                        @if (friendsNotInGroup == null)
                        {
                            <div style="text-align:center; padding:10px; color:var(--text-muted); font-size:0.85rem;">Đang tải...</div>
                        }
                        else if (!friendsNotInGroup.Any())
                        {
                            <div style="text-align:center; padding:10px; color:var(--text-muted); font-size:0.85rem;">Không có bạn bè nào để thêm.</div>
                        }
                        else
                        {
                            <div style="max-height:160px; overflow-y:auto; display:flex; flex-direction:column; gap:6px; margin-bottom:10px;">
                                @foreach (var f in friendsNotInGroup)
                                {
                                    bool isChecked = selectedFriendIds.Contains(f.UserId);
                                    <div @onclick="() => ToggleFriendSelection(f.UserId)"
                                         style="display:flex; align-items:center; gap:10px; padding:8px; border-radius:8px; cursor:pointer; background:@(isChecked ? "rgba(var(--accent-rgb),0.1)" : "transparent"); transition: background 0.15s;">
                                        <div style="width:32px; height:32px; border-radius:50%; background:var(--accent); display:flex; align-items:center; justify-content:center; font-size:0.75rem; color:#fff; overflow:hidden; flex-shrink:0;">
                                            @if (!string.IsNullOrEmpty(f.AvatarUrl))
                                            { <img src="@f.AvatarUrl" style="width:100%;height:100%;object-fit:cover;"/> }
                                            else { @GetInitials(f.DisplayName) }
                                        </div>
                                        <span style="flex:1; font-size:0.9rem;">@(f.DisplayName ?? f.PhoneNumber)</span>
                                        <div style="width:18px; height:18px; border-radius:50%; border:2px solid var(--accent); background:@(isChecked ? "var(--accent)" : "transparent"); display:flex; align-items:center; justify-content:center; flex-shrink:0; color:#fff; font-size:0.65rem;">
                                            @if (isChecked) { <span>✓</span> }
                                        </div>
                                    </div>
                                }
                            </div>
                            <button @onclick="AddSelectedMembers" disabled="@(!selectedFriendIds.Any() || isGroupActionLoading)"
                                    style="width:100%; padding:8px; background:var(--accent); border:none; border-radius:8px; color:#fff; cursor:pointer; font-size:0.85rem; opacity:@(selectedFriendIds.Any() ? "1" : "0.5");">
                                @if (isGroupActionLoading) { <span class="spinner-sm"></span> }
                                Thêm @(selectedFriendIds.Count > 0 ? $"({selectedFriendIds.Count})" : "") thành viên
                            </button>
                        }
                    </div>
                }

                @if (groupActionError != null)
                {
                    <div class="modal-error" style="margin-bottom:10px;">@groupActionError</div>
                }

                <!-- Danh sách thành viên -->
                <div style="font-size:0.8rem; font-weight:600; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:8px;">
                    Thành viên
                </div>
                <div style="display:flex; flex-direction:column; gap:4px;">
                    @foreach (var p in conversationParticipants)
                    {
                        bool isAdmin = p.Role == 0; // 0 = Admin
                        <div style="display:flex; align-items:center; gap:10px; padding:9px 10px; border-radius:10px; transition: background 0.15s; cursor:pointer;"
                             class="group-member-row"
                             @onclick="() => OpenMemberProfile(p.UserId)">
                            <div style="width:38px; height:38px; border-radius:50%; background:var(--accent); display:flex; align-items:center; justify-content:center; font-size:0.8rem; font-weight:700; color:#fff; overflow:hidden; flex-shrink:0;">
                                @if (!string.IsNullOrEmpty(p.AvatarUrl))
                                { <img src="@p.AvatarUrl" style="width:100%;height:100%;object-fit:cover;"/> }
                                else { @GetInitials(p.DisplayName) }
                            </div>
                            <div style="flex:1; min-width:0;">
                                <div style="font-weight:500; font-size:0.9rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@(p.DisplayName ?? "Người dùng")</div>
                                @if (!string.IsNullOrEmpty(p.PhoneNumber))
                                {
                                    <div style="font-size:0.75rem; color:var(--text-muted);">@p.PhoneNumber</div>
                                }
                            </div>
                            @if (isAdmin)
                            {
                                <span style="font-size:0.7rem; background:rgba(255,165,0,0.15); color:orange; padding:2px 8px; border-radius:20px; font-weight:600; flex-shrink:0;">👑 Trưởng nhóm</span>
                            }
                            @if (isCurrentUserAdmin && !isAdmin && p.UserId != currentUserId)
                            {
                                <button @onclick:stopPropagation="true"
                                        @onclick="() => RemoveMember(p.UserId)"
                                        title="Xóa thành viên"
                                        style="background:none; border:none; cursor:pointer; color:#ff4d4f; font-size:1rem; padding:4px; border-radius:6px; flex-shrink:0; transition: background 0.15s;"><Icon Name="trash" Size="18" /></button>
                            }
                        </div>
                    }
                </div>

                <!-- Giải tán nhóm (Admin only) -->
                @if (isCurrentUserAdmin)
                {
                    <div style="border-top:1px solid var(--border); margin-top:16px; padding-top:14px;">
                        <button @onclick="ConfirmDisbandGroup" disabled="@isGroupActionLoading"
                                style="width:100%; padding:10px; background:rgba(255,77,79,0.1); border:1px solid rgba(255,77,79,0.4); border-radius:10px; color:#ff4d4f; cursor:pointer; font-size:0.9rem; font-weight:600; transition: background 0.2s;">
                            @if (isGroupActionLoading) { <span class="spinner-sm"></span> }
                            🔴 Giải tán nhóm
                        </button>
                    </div>
                }

            </div>
        </div>
    </div>
}

<!-- Confirm Disband Modal -->
@if (showDisbandConfirm)
{
