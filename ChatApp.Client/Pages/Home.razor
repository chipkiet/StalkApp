    // ── Pinboard Canvas Handlers ─────────────────────────────
    private async Task HandleItemMoved((Guid id, double x, double y) data)
    {
        var item = MyCanvasItems.FirstOrDefault(i => i.Id == data.id);
        if (item != null)
        {
            item.PositionX = data.x;
            item.PositionY = data.y;
            
            var cmd = new { Id = data.id, PositionX = data.x, PositionY = data.y, ZIndex = item.ZIndex };
            if (hubConnection != null)
            {
                await hubConnection.SendAsync("MovePinboardItem", cmd, selectedId.ToString());
            }
        }
    }

    private async Task HandleTaskCompleted(Guid id)
    {
        var item = MyCanvasItems.FirstOrDefault(i => i.Id == id);
        if (item != null)
        {
            item.IsCompleted = true;
            StateHasChanged();
            
            var cmd = new { TaskId = id };
            if (hubConnection != null)
            {
                await hubConnection.SendAsync("CompleteCanvasTask", cmd, selectedId.ToString());
            }
        }
    }

    private async Task HandleItemDeleted(Guid id)
    {
        var item = MyCanvasItems.FirstOrDefault(i => i.Id == id);
        if (item != null)
        {
            MyCanvasItems.Remove(item);
            StateHasChanged();
            
            var cmd = new { Id = id };
            if (hubConnection != null)
            {
                await hubConnection.SendAsync("DeletePinboardItem", cmd, selectedId.ToString());
            }
        }
    }

    private async Task HandleItemCreatedFromDrop((Guid msgId, string content, double x, double y) data)
    {
        var cmd = new {
            ConversationId = selectedId, 
            Type = ChatApp.Shared.Enums.PinboardItemType.Task,
            Content = data.content,
            PositionX = data.x,
            PositionY = data.y,
            LinkedMessageId = (Guid?)null,
            ZIndex = MyCanvasItems.Count + 1
        };
        
        if (hubConnection != null)
        {
            await hubConnection.SendAsync("CreatePinboardItem", cmd);
        }
    }

    private async Task HandleItemContentUpdated((Guid id, string content) data)
    {
        var item = MyCanvasItems.FirstOrDefault(i => i.Id == data.id);
        if (item != null)
        {
            item.Content = data.content;
            StateHasChanged();

            var cmd = new { Id = data.id, Content = data.content };
            if (hubConnection != null)
            {
                await hubConnection.SendAsync("UpdatePinboardItemContent", cmd, selectedId.ToString());
            }
        }
    }

    private async Task HandleConnectionCreated((Guid sourceId, Guid targetId) data)
    {
        try
        {
            var command = new 
            {
                SourceItemId = data.sourceId,
                TargetItemId = data.targetId
            };

            var response = await Http.PostAsJsonAsync($"api/pinboard/{selectedConversation?.ConversationId}/connections", command);
            if (response.IsSuccessStatusCode)
            {
                var connection = await response.Content.ReadFromJsonAsync<PinboardConnectionDto>();
                if (connection != null && MyCanvasConnections != null)
                {
                    MyCanvasConnections.Add(connection);
                    StateHasChanged();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating connection: {ex.Message}");
        }
    }

    private void HandleNotificationClicked(Guid conversationId)
    {
        var conv = inboxItems?.FirstOrDefault(i => i.ConversationId == conversationId);
        if (conv != null)
        {
            _ = SelectConversation(conv);
            InvokeAsync(StateHasChanged);
        }
    }
