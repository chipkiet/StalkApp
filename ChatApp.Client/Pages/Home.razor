    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null || selectedId == Guid.Empty || hubConnection == null) return;

        isUploading = true;
        StateHasChanged();

        try
        {
            var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");
            token = token?.Trim('"');

            using var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024)); // max 20MB
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(fileContent, "file", file.Name);

            var request = new HttpRequestMessage(HttpMethod.Post, "/api/attachments/upload")
            {
                Content = content
            };
            if (!string.IsNullOrEmpty(token))
            {
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<UploadResponse>();
                if (result != null && !string.IsNullOrEmpty(result.Url))
                {
                    bool isImage = file.ContentType.StartsWith("image/");
                    var command = new
                    {
                        ConversationId = selectedId,
                        SenderId = currentUserId,
                        MessageType = isImage ? MessageType.Image : MessageType.File,
                        Content = isImage ? "Đã gửi một ảnh" : file.Name,
                        AttachmentUrl = result.Url,
                        AttachmentName = result.OriginalName,
                        AttachmentContentType = result.ContentType,
                        AttachmentSize = result.Size,
                        ReplyToMessageId = replyingToMessage?.Id
                    };
                    await hubConnection.SendAsync("SendMessage", command);
                }
            }
        }
        catch
        {
            // Xử lý lỗi upload
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

    private void HandleChatInput(ChangeEventArgs e)
    {
        newMessageContent = e.Value?.ToString() ?? "";

        if (!string.IsNullOrEmpty(newMessageContent))
        {
            var parts = newMessageContent.Split(' ');
            var lastWord = parts.Last();
            
            if (lastWord.StartsWith("@") && conversationParticipants != null)
            {
                var query = lastWord.Substring(1).ToLower();
                mentionCandidates = conversationParticipants
                    .Where(p => p.UserId != currentUserId && (p.DisplayName?.ToLower().Contains(query) == true || p.PhoneNumber?.Contains(query) == true))
                    .ToList();
                
                showMentionPopup = true;
            }
            else
            {
                showMentionPopup = false;
            }
        }
        else
        {
            showMentionPopup = false;
        }
    }

    private void InsertMention(ParticipantProfileDto p)
    {
        if (string.IsNullOrEmpty(p.DisplayName)) return;
        
        var parts = newMessageContent.Split(' ').ToList();
        parts.RemoveAt(parts.Count - 1); // Remove the @query part
        
        var mentionText = $"@{p.DisplayName} ";
        parts.Add(mentionText);
        
        newMessageContent = string.Join(" ", parts);
        if (!currentMentions.Contains(p.UserId))
        {
            currentMentions.Add(p.UserId);
        }
        
        showMentionPopup = false;
        StateHasChanged();
    }

