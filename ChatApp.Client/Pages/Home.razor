    private void AddMember()
    {
        if (foundUser == null) return;
        if (foundUser.Id == currentUserId) { searchError = "Không thể thêm chính bạn."; return; }
        if (groupMembers.Any(m => m.Id == foundUser.Id)) { searchError = "Người này đã được thêm."; return; }
        groupMembers.Add(foundUser);
        foundUser = null;
        searchPhone = "";
        searchError = null;
    }

    private async Task CreateConversation()
    {
        isCreating = true;
        createError = null;
        StateHasChanged();
        try
        {
            List<Guid> participantIds;
            string? title;

            if (convType == ConversationType.Direct)
            {
                participantIds = new List<Guid> { foundUser!.Id };
                title = foundUser.DisplayName;
            }
            else
            {
                participantIds = groupMembers.Select(m => m.Id).ToList();
                title = groupTitle.Trim();
            }

            var body = new
            {
                CreatorId = currentUserId,
                Title = title,
                Type = (int)convType,
                ParticipantIds = participantIds
            };

            var resp = await Http.PostAsJsonAsync("/api/conversations", body);
            if (resp.IsSuccessStatusCode)
            {
                var newConvId = await resp.Content.ReadFromJsonAsync<Guid>();
                CloseModal();
                await LoadInbox();
                
                if (inboxItems != null)
                {
                    var itemToSelect = inboxItems.FirstOrDefault(i => i.ConversationId == newConvId);
                    if (itemToSelect != null)
                    {
                        await SelectConversation(itemToSelect);
                    }
                }
            }
            else
            {
                createError = "Không thể tạo cuộc trò chuyện. Vui lòng thử lại.";
            }
        }
        catch
        {
            createError = "Lỗi kết nối. Vui lòng thử lại.";
        }
        finally
        {
            isCreating = false;
            StateHasChanged();
        }
    }

    // ── Helpers ──────────────────────────────────────────────
    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
        return name.Length >= 2 ? name[..2].ToUpper() : name.ToUpper();
    }

    private string FormatTime(DateTime? dt)
    {
        if (dt == null) return "";
        var local = dt.Value.ToLocalTime();
        var now = DateTime.Now;
        if (local.Date == now.Date) return local.ToString("HH:mm");
        if (local.Date == now.Date.AddDays(-1)) return "Hôm qua";
        return local.ToString("dd/MM");
    }

    private string TruncateMessage(string? msg)
    {
        if (string.IsNullOrEmpty(msg)) return "";
        return msg.Length > 40 ? msg[..40] + "..." : msg;
    }

