<!-- ═══ MODAL ĐẶT GIỜ GỬI (SCHEDULE MESSAGE) ═══ -->
@if (showScheduleModal)
{
    <div class="modal-backdrop" @onclick="CloseScheduleModal">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Hẹn giờ gửi tin nhắn</h3>
                <button class="modal-close-btn" @onclick="CloseScheduleModal"><Icon Name="x" Size="16" /></button>
            </div>
            <div class="modal-body">
                <div class="modal-form-group">
                    <label class="modal-label">Nội dung tin nhắn</label>
                    <textarea class="modal-input" rows="3" placeholder="Nhập nội dung..." @bind="scheduleMessageContent" style="resize:none; padding:10px;"></textarea>
                </div>
                <div class="modal-form-group">
                    <label class="modal-label">Thời gian gửi (tương lai)</label>
                    <input class="modal-input" type="datetime-local" @bind="scheduleTime" />
                </div>
            </div>
            @if (scheduleError != null)
            {
                <div class="modal-error" style="margin: 0 20px 12px;">@scheduleError</div>
            }
            <div class="modal-footer">
                <button class="modal-cancel-btn" @onclick="CloseScheduleModal">Hủy</button>
                <button class="modal-create-btn" @onclick="ConfirmScheduleMessage" disabled="@isScheduling">
                    @if (isScheduling) { <span class="spinner-sm"></span> }
                    <span>Đặt lịch</span>
                </button>
            </div>
        </div>
    </div>
}

<ChatApp.Client.Shared.UserProfileModal @ref="userProfileModal" />

@code {
    // ── Chat state ───────────────────────────────────────────
    private HubConnection? hubConnection;
    private List<MessageDto>? messages;
    private bool isLoadingMessages = false;
    private string newMessageContent = "";
    private bool isUploading = false;
    
    // Schedule state
    private bool showScheduleModal = false;
    private string scheduleMessageContent = "";
    private DateTime scheduleTime = DateTime.Now.AddMinutes(5);
    private string? scheduleError;
    private bool isScheduling = false;
    
    private void OpenSchedulePopup()
    {
        if (selectedConversation == null) return;
        scheduleMessageContent = newMessageContent;
        scheduleTime = DateTime.Now.AddMinutes(5);
        scheduleError = null;
        showScheduleModal = true;
    }
    
    private void CloseScheduleModal()
    {
        showScheduleModal = false;
    }
    
    private async Task ConfirmScheduleMessage()
    {
        if (string.IsNullOrWhiteSpace(scheduleMessageContent))
        {
            scheduleError = "Vui lòng nhập nội dung";
            return;
        }
        if (scheduleTime <= DateTime.Now)
        {
            scheduleError = "Thời gian phải chọn ở tương lai";
            return;
        }
        
        isScheduling = true;
        scheduleError = null;
        try
        {
            var req = new ChatApp.Shared.DTOs.Messages.ScheduleMessageRequest
            {
                ConversationId = selectedConversation.ConversationId,
                Content = scheduleMessageContent,
                ScheduledAt = scheduleTime.ToUniversalTime()
            };
            using var res = await Http.PostAsJsonAsync("api/messages/schedule", req);
            if (res.IsSuccessStatusCode)
            {
                newMessageContent = "";
                CloseScheduleModal();
                await JS.InvokeVoidAsync("alert", "Đã hẹn giờ gửi tin nhắn thành công");
            }
            else
            {
                scheduleError = "Lỗi khi đặt lịch hẹn";
            }
        }
        catch (Exception ex)
        {
            scheduleError = ex.Message;
        }
        isScheduling = false;
    }
    
    // Mention state
    private bool showMentionPopup = false;
    private List<ParticipantProfileDto>? mentionCandidates;
    private List<Guid> currentMentions = new();
    
    // ── Pinboard State ───────────────────────────────────────
    private List<PinboardItemDto> MyCanvasItems = new();
    private List<PinboardConnectionDto> MyCanvasConnections = new();

    // ── Message Features (Reply, Forward, Reaction) ─────────
    private MessageDto? replyingToMessage;
    // Trạng thái modal forward
    private bool isForwardModalOpen = false;
    private Guid? messageToForward = null;
    private List<InboxItemDto>? forwardInboxItems = null;
    private bool isForwarding = false;
    private string? forwardError;

    // Trạng thái modal Delete Conversation
    private bool showDeleteConvModal = false;
    private Guid conversationToDelete;

    // ── Toggle Pinboard ──────────────────────────────────────────
    private bool isCanvasOpen = false;

    private void ToggleCanvas()
    {
        isCanvasOpen = !isCanvasOpen;
        StateHasChanged();
    }

    // ── Inbox state ──────────────────────────────────────────
    private List<InboxItemDto>? inboxItems;
    private InboxItemDto? selectedConversation;
    private Guid selectedId;
    private bool isLoading = true;
    private string? errorMessage;
    // Cursors (UserId -> (X, Y, Name, Color))
    private Dictionary<Guid, (double X, double Y, string Name, string Color)> activeCursors = new();
    private Dictionary<Guid, System.Timers.Timer> cursorTimers = new();

    private string[] cursorColors = new[] { "#ff4757", "#2ed573", "#1e90ff", "#ffa502", "#ff6b81", "#7bed9f" };

    private string GetCursorColor(Guid userId)
    {
        var index = Math.Abs(userId.GetHashCode()) % cursorColors.Length;
        return cursorColors[index];
    }
    private Guid currentUserId;

    // ── Modal state ──────────────────────────────────────────
    private bool showNewConvModal = false;
    private ConversationType convType = ConversationType.Direct;
    private string searchPhone = "";
    private bool isSearching = false;
    private string? searchError;
    private FoundUserDto? foundUser;

    // Group
    private string groupTitle = "";
    private List<FoundUserDto> groupMembers = new();

    // Create
    private bool isCreating = false;
    private string? createError;

    private bool CanCreate => convType == ConversationType.Direct
        ? foundUser != null
        : !string.IsNullOrWhiteSpace(groupTitle) && groupMembers.Any();

    // ── Layout State ─────────────────────────────────────────
    private double inboxWidth = 320;
    private bool isResizing = false;
    private double startX = 0;
    private double startWidth = 0;

    private void HandleMouseDown(MouseEventArgs e)
    {
        isResizing = true;
        startX = e.ClientX;
        startWidth = inboxWidth;
    }

    private void HandleMouseMove(MouseEventArgs e)
    {
        if (!isResizing) return;
        var diff = e.ClientX - startX;
        var newWidth = startWidth + diff;
        if (newWidth < 250) newWidth = 250; // min width
        if (newWidth > 600) newWidth = 600; // max width
        inboxWidth = newWidth;
    }

    private void HandleMouseUp(MouseEventArgs e)
    {
        isResizing = false;
    }

    // ── Profile Modal ────────────────────────────────────────
    private bool showProfileModal = false;
    private List<ParticipantProfileDto>? conversationParticipants;

    // ── Group Management State ───────────────────────────────
    private bool isCurrentUserAdmin = false;
    private bool isEditingGroupName = false;
    private string editGroupName = "";
    private bool showAddMemberPanel = false;
    private List<FriendForGroupDto>? friendsNotInGroup;
    private List<Guid> selectedFriendIds = new();
    private bool isGroupActionLoading = false;
    private string? groupActionError;
    private bool showDisbandConfirm = false;

    public class ParticipantProfileDto
    {
        public Guid UserId { get; set; }
        public string? DisplayName { get; set; }
        public string? PhoneNumber { get; set; }
        public string? AvatarUrl { get; set; }
        public string? Bio { get; set; }
        public int Role { get; set; } // 0 = Admin, 1 = Member
    }

    public class FriendForGroupDto
    {
        public Guid UserId { get; set; }
        public string? DisplayName { get; set; }
        public string? PhoneNumber { get; set; }
        public string? AvatarUrl { get; set; }
    }

    private ChatApp.Client.Shared.UserProfileModal userProfileModal = default!;

    private async Task OpenProfileModal()
    {
        if (selectedConversation == null) return;
        try
        {
            var res = await Http.GetFromJsonAsync<List<ParticipantProfileDto>>($"/api/conversations/{selectedConversation.ConversationId}/participants");
            if (res != null)
            {
                if (selectedConversation.Type == ChatApp.Domain.Enums.ConversationType.Direct)
                {
                    var otherUser = res.FirstOrDefault(p => p.UserId != currentUserId);
                    if (otherUser != null)
                    {
                        if (userProfileModal != null)
                        {
                            await userProfileModal.OpenAsync(otherUser.UserId);
                        }
                    }
                }
                else
                {
                    conversationParticipants = res;
                    isCurrentUserAdmin = res.Any(p => p.UserId == currentUserId && p.Role == 0);
                    isEditingGroupName = false;
                    showAddMemberPanel = false;
                    friendsNotInGroup = null;
                    selectedFriendIds.Clear();
                    groupActionError = null;
                    showDisbandConfirm = false;
                    showProfileModal = true;
                    StateHasChanged();
                }
            }
        }
        catch
        {
            // ignore
        }
    }

    private async Task OpenMemberProfile(Guid userId)
    {
        if (userProfileModal != null)
        {
            await userProfileModal.OpenAsync(userId);
        }
    }

    private void CloseProfileModal()
    {
        showProfileModal = false;
        isEditingGroupName = false;
        showAddMemberPanel = false;
        friendsNotInGroup = null;
        selectedFriendIds.Clear();
        groupActionError = null;
        showDisbandConfirm = false;
    }

    // ── Group: Sửa tên nhóm ──────────────────────────────────
    private async Task SaveGroupName()
    {
        if (selectedConversation == null || string.IsNullOrWhiteSpace(editGroupName)) return;
        isGroupActionLoading = true;
        groupActionError = null;
        try
        {
            var body = new { Title = editGroupName.Trim(), AvatarUrl = (string?)null };
            var response = await Http.PutAsJsonAsync($"/api/conversations/{selectedConversation.ConversationId}/group", body);
            if (response.IsSuccessStatusCode)
            {
                isEditingGroupName = false;
                // Update local state
                if (inboxItems != null)
                {
                    var idx = inboxItems.FindIndex(i => i.ConversationId == selectedConversation.ConversationId);
                    if (idx != -1)
                    {
                        inboxItems[idx] = inboxItems[idx] with { Title = editGroupName.Trim() };
                        selectedConversation = inboxItems[idx];
                    }
                }
            }
            else
            {
                groupActionError = "Không thể cập nhật tên nhóm.";
            }
        }
        catch { groupActionError = "Lỗi kết nối.";
        }
        finally { isGroupActionLoading = false; StateHasChanged(); }
    }

    // ── Group: Đổi ảnh nhóm ──────────────────────────────────
    private async Task HandleGroupAvatarChange(InputFileChangeEventArgs e)
    {
        if (selectedConversation == null) return;
        isGroupActionLoading = true;
        groupActionError = null;
        try
        {
            var file = e.File;
            using var content = new MultipartFormDataContent();
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            content.Add(new StreamContent(stream), "file", file.Name);

            var uploadResp = await Http.PostAsync("/api/attachments/upload", content);
            if (!uploadResp.IsSuccessStatusCode)
            {
                groupActionError = "Không thể tải ảnh lên.";
                return;
            }
            var uploadResult = await uploadResp.Content.ReadFromJsonAsync<UploadResultDto>();
            if (uploadResult?.Url == null) { groupActionError = "Không nhận được URL ảnh."; return; }

            var body = new { Title = (string?)null, AvatarUrl = uploadResult.Url };
            var response = await Http.PutAsJsonAsync($"/api/conversations/{selectedConversation.ConversationId}/group", body);
            if (response.IsSuccessStatusCode)
            {
                if (inboxItems != null)
                {
                    var idx = inboxItems.FindIndex(i => i.ConversationId == selectedConversation.ConversationId);
                    if (idx != -1)
                    {
                        inboxItems[idx] = inboxItems[idx] with { AvatarUrl = uploadResult.Url };
                        selectedConversation = inboxItems[idx];
                    }
                }
            }
            else { groupActionError = "Không thể cập nhật ảnh nhóm."; }
        }
        catch { groupActionError = "Lỗi kết nối."; }
        finally { isGroupActionLoading = false; StateHasChanged(); }
    }

    private class UploadResultDto { public string? Url { get; set; } }

    // ── Group: Mở panel thêm thành viên ─────────────────────
    private async Task OpenAddMemberPanel()
    {
        showAddMemberPanel = true;
        friendsNotInGroup = null;
        selectedFriendIds.Clear();
        try
        {
            var allFriends = await Http.GetFromJsonAsync<List<ChatApp.Shared.DTOs.Friends.FriendDto>>("/api/friends");
            if (allFriends != null && conversationParticipants != null)
            {
                var existingIds = conversationParticipants.Select(p => p.UserId).ToHashSet();
                friendsNotInGroup = allFriends
                    .Where(f => !existingIds.Contains(f.UserId))
                    .Select(f => new FriendForGroupDto
                    {
                        UserId = f.UserId,
                        DisplayName = f.DisplayName,
                        PhoneNumber = f.PhoneNumber,
                        AvatarUrl = f.AvatarUrl
                    }).ToList();
            }
        }
        catch { friendsNotInGroup = new(); }
        StateHasChanged();
    }

    private void ToggleFriendSelection(Guid friendId)
    {
        if (selectedFriendIds.Contains(friendId)) selectedFriendIds.Remove(friendId);
        else selectedFriendIds.Add(friendId);
        StateHasChanged();
    }

    private async Task AddSelectedMembers()
    {
        if (selectedConversation == null || !selectedFriendIds.Any()) return;
        isGroupActionLoading = true;
        groupActionError = null;
        try
        {
            var body = new { UserIds = selectedFriendIds };
            var response = await Http.PostAsJsonAsync($"/api/conversations/{selectedConversation.ConversationId}/members", body);
            if (response.IsSuccessStatusCode)
            {
                showAddMemberPanel = false;
                selectedFriendIds.Clear();
                // Reload participants
                var res = await Http.GetFromJsonAsync<List<ParticipantProfileDto>>($"/api/conversations/{selectedConversation.ConversationId}/participants");
                if (res != null) conversationParticipants = res;
            }
            else { groupActionError = "Không thể thêm thành viên."; }
        }
        catch { groupActionError = "Lỗi kết nối."; }
        finally { isGroupActionLoading = false; StateHasChanged(); }
    }

    // ── Group: Xóa thành viên (Admin only) ──────────────────
    private async Task RemoveMember(Guid targetUserId)
    {
        if (selectedConversation == null) return;
        isGroupActionLoading = true;
        groupActionError = null;
        try
        {
            var response = await Http.DeleteAsync($"/api/conversations/{selectedConversation.ConversationId}/members/{targetUserId}");
            if (response.IsSuccessStatusCode)
            {
                conversationParticipants?.RemoveAll(p => p.UserId == targetUserId);
            }
            else { groupActionError = "Không thể xóa thành viên."; }
        }
        catch { groupActionError = "Lỗi kết nối."; }
        finally { isGroupActionLoading = false; StateHasChanged(); }
    }

    // ── Group: Giải tán nhóm (Admin only) ───────────────────
    private void ConfirmDisbandGroup() => showDisbandConfirm = true;

    private async Task DisbandGroup()
    {
        if (selectedConversation == null) return;
        isGroupActionLoading = true;
        groupActionError = null;
        try
        {
            var response = await Http.DeleteAsync($"/api/conversations/{selectedConversation.ConversationId}/disband");
            if (response.IsSuccessStatusCode)
            {
                var disbandedId = selectedConversation.ConversationId;
                showDisbandConfirm = false;
                showProfileModal = false;
                selectedConversation = null;
                selectedId = Guid.Empty;
                messages = null;
                inboxItems?.RemoveAll(i => i.ConversationId == disbandedId);
            }
            else { groupActionError = "Không thể giải tán nhóm."; showDisbandConfirm = false; }
        }
        catch { groupActionError = "Lỗi kết nối."; showDisbandConfirm = false; }
        finally { isGroupActionLoading = false; StateHasChanged(); }
    }

    // ── Call State ───────────────────────────────────────────
    private bool isCalling = false;
    private bool isIncomingCall = false;
    private Guid incomingCallId;
    private Guid incomingConversationId; // ← ConversationId của cuộc gọi đến (không phụ thuộc selectedId)
    private ChatApp.Domain.Enums.CallType activeCallType;
    private ChatApp.Domain.Enums.CallType incomingCallType;
    private string? incomingCallTitle;
    private Guid activeCallId;
    private Guid activeConversationId; // ← ConversationId của cuộc gọi đang active
    private bool isAudioMuted = false;
    private bool isVideoMuted = false;
    private DotNetObjectReference<Home>? objRef;
    
    // Timer
    private System.Timers.Timer? callTimer;
    private int callSeconds = 0;
    private string callTimerDisplay = "00:00";

    // ─────────────────────────────────────────────────────────
    private bool messagesRendered = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (messages != null && !isLoadingMessages && !messagesRendered)
        {
            messagesRendered = true;
            try
            {
                await JS.InvokeVoidAsync("canvasPhysics.initDraggableMessages");
                await JS.InvokeVoidAsync("scrollToBottom", "chat-messages-area");
            }
            catch { /* Ignore if script not loaded yet */ }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        NotificationSvc.OnNotificationClicked += HandleNotificationClicked;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userIdStr = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value 
            ?? user.FindFirst("sub")?.Value 
            ?? user.FindFirst("nameid")?.Value;
        if (!Guid.TryParse(userIdStr, out currentUserId))
        {
            Nav.NavigateTo("/login");
            return;
        }

        hubConnection = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri("/chathub"), options =>
            {
                options.AccessTokenProvider = async () =>
                {
                    var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");
                    // Blazor sessionStorage often wraps strings in quotes, remove them if present
                    return string.IsNullOrEmpty(token) ? null : token.Trim('"');
                };
            })
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<MessageDto>("ReceiveNewMessage", async (message) =>
        {
            if (selectedId == message.ConversationId)
            {
                if (messages == null) messages = new List<MessageDto>();
                messages.Add(message);

                if (inboxItems != null)
                {
                    var conv = inboxItems.FirstOrDefault(c => c.ConversationId == message.ConversationId);
                    if (conv != null)
                    {
                        var updatedConv = conv with { LastMessage = message.Content ?? "Tệp đính kèm", LastMessageAt = message.CreatedAt };
                        var idx = inboxItems.IndexOf(conv);
                        if (idx != -1) inboxItems[idx] = updatedConv;
                        if (selectedConversation?.ConversationId == updatedConv.ConversationId)
                        {
                            selectedConversation = updatedConv;
                        }
                        inboxItems = inboxItems.OrderByDescending(x => x.IsPinned).ThenByDescending(x => x.LastMessageAt).ToList();
                    }
                }

                await InvokeAsync(StateHasChanged);
                try { await JS.InvokeVoidAsync("scrollToBottom", "chat-messages-area"); } catch {}
            }
            else
            {
                InvokeAsync(LoadInbox);
                
                // Push local toast notification
                if (inboxItems != null)
                {
                    var inboxItem = inboxItems.FirstOrDefault(i => i.ConversationId == message.ConversationId);
                    bool isMentioned = message.MentionedUserIds != null && message.MentionedUserIds.Contains(currentUserId);
                    if (inboxItem != null && (!inboxItem.IsMuted || isMentioned))
                    {
                        InvokeAsync(async () =>
                        {
                            string senderName = "Ai đó";
                            try
                            {
                                var userDto = await Http.GetFromJsonAsync<FoundUserDto>($"/api/users/{message.SenderId}");
                                if (userDto != null)
                                {
                                    senderName = !string.IsNullOrWhiteSpace(userDto.DisplayName) 
                                        ? userDto.DisplayName 
                                        : (userDto.Username ?? "Ai đó");
                                }
                            }
                            catch { }

                            var previewText = message.Content ?? "Đã gửi một tệp";
                            if (inboxItem.Type == ChatApp.Domain.Enums.ConversationType.Group)
                            {
                                previewText = $"{senderName}: {previewText}";
                            }

                            NotificationSvc.Push(new ChatApp.Client.Layout.NotificationItem
                            {
                                ConversationId = message.ConversationId,
                                ConversationTitle = isMentioned ? "💬 Ai đó nhắc đến bạn" : (inboxItem.Title ?? "Tin nhắn mới"),
                                MessagePreview = previewText,
                                Timestamp = message.CreatedAt
                            });
                        });
                    }
                }
            }
        });

        hubConnection.On<MessageDto>("MessageReactionUpdated", (updatedMsg) =>
        {
            if (messages != null && selectedId == updatedMsg.ConversationId)
            {
                var idx = messages.FindIndex(m => m.Id == updatedMsg.Id);
                if (idx != -1)
                {
                    messages[idx] = updatedMsg;
                    InvokeAsync(StateHasChanged);
                }
            }
        });

        // ── Call SignalR Listeners ──────────────────────────────
        hubConnection.On<Guid>("UserOnline", (userId) =>
        {
            userProfileModal?.UpdatePresence(userId, true, null);
        });

        hubConnection.On<UserOfflineMessage>("UserOffline", (msg) =>
        {
            userProfileModal?.UpdatePresence(msg.UserId, false, msg.LastSeenAt);
        });

        hubConnection.On<Guid>("CallInitiated", (callId) =>
        {
            activeCallId = callId;
            InvokeAsync(StateHasChanged);
        });

        hubConnection.On<Guid, Guid, Guid, int>("IncomingCall", (callId, conversationId, callerId, type) =>
        {
            // Chặn duplicate nếu đã đang hiện thông báo cuộc gọi này
            if (isIncomingCall && incomingCallId == callId) return;

            incomingCallId = callId;
            incomingConversationId = conversationId; // ← Lưu đúng conversationId
            incomingCallType = (ChatApp.Domain.Enums.CallType)type;
            var conv = inboxItems?.FirstOrDefault(c => c.ConversationId == conversationId);
            incomingCallTitle = conv?.Title ?? "Ai đó";
            isIncomingCall = true;
            InvokeAsync(StateHasChanged);
        });

        hubConnection.On<Guid>("CallAccepted", async (callId) =>
        {
            if (activeCallId == callId)
            {
                if (objRef != null)
                {
                    await JS.InvokeVoidAsync("window.WebRTC.startCall");
                }
                StartCallTimer();
                InvokeAsync(StateHasChanged);
            }
        });

        hubConnection.On<Guid>("CallRejected", (callId) =>
        {
            if (activeCallId == callId)
            {
                EndCallCleanup();
            }
        });

        hubConnection.On<Guid>("CallEnded", (callId) =>
        {
            if (activeCallId == callId || incomingCallId == callId)
            {
                EndCallCleanup();
            }
        });

        hubConnection.On<string>("ReceiveWebRTCSignal", async (payload) =>
        {
            if (isCalling && objRef != null)
            {
                await JS.InvokeVoidAsync("window.WebRTC.handleSignal", payload);
            }
        });

        // ── Pinboard Listeners ──────────────────────────────────
        hubConnection.On<PinboardItemDto>("PinboardItemCreated", (item) =>
        {
            if (selectedId == item.ConversationId)
            {
                if (MyCanvasItems == null) MyCanvasItems = new();
                MyCanvasItems.Add(item);
                MyCanvasItems = MyCanvasItems.ToList();
                InvokeAsync(StateHasChanged);
            }
        });

        hubConnection.On<PinboardItemDto>("PinboardItemMoved", (item) =>
        {
            if (selectedId == item.ConversationId && MyCanvasItems != null)
            {
                var existing = MyCanvasItems.FirstOrDefault(i => i.Id == item.Id);
                if (existing != null)
                {
                    existing.PositionX = item.PositionX;
                    existing.PositionY = item.PositionY;
                    existing.ZIndex = item.ZIndex;
                    MyCanvasItems = MyCanvasItems.ToList();
                    InvokeAsync(StateHasChanged);
                }
            }
        });

        hubConnection.On<Guid, double, double>("PinboardItemMovedLive", (itemId, x, y) =>
        {
            // Update UI smoothly via JS without triggering Blazor StateHasChanged
            JS.InvokeVoidAsync("canvasPhysics.updateCardPosition", itemId.ToString(), x, y);
        });

        hubConnection.On<Guid>("PinboardItemDeleted", (itemId) =>
        {
            if (MyCanvasItems != null)
            {
                var item = MyCanvasItems.FirstOrDefault(i => i.Id == itemId);
                if (item != null)
                {
                    MyCanvasItems.Remove(item);
                    MyCanvasItems = MyCanvasItems.ToList();
                    InvokeAsync(StateHasChanged);
                }
            }
        });

        hubConnection.On<PinboardItemDto>("PinboardItemUpdated", (cmd) =>
        {
            if (MyCanvasItems != null)
            {
                var item = MyCanvasItems.FirstOrDefault(i => i.Id == cmd.Id);
                if (item != null)
                {
                    item.Content = cmd.Content;
                    InvokeAsync(StateHasChanged);
                }
            }
        });

        hubConnection.On<ChatApp.Shared.DTOs.Users.KarmaUpdateDto, Guid>("CanvasTaskCompleted", (karma, taskId) =>
        {
            if (MyCanvasItems != null)
            {
                var existing = MyCanvasItems.FirstOrDefault(i => i.Id == taskId);
                if (existing != null)
                {
                    existing.IsCompleted = true;
                    InvokeAsync(StateHasChanged);
                }
            }
        });

        hubConnection.On<Guid, double, double>("CursorMoved", (userId, x, y) =>
        {
            if (userId != currentUserId)
            {
                var participant = conversationParticipants?.FirstOrDefault(p => p.UserId == userId);
                var name = participant?.DisplayName ?? "User";
                var color = GetCursorColor(userId);
                
                activeCursors[userId] = (x, y, name, color);
                
                // Clear old timer
                if (cursorTimers.ContainsKey(userId))
                {
                    cursorTimers[userId].Stop();
                    cursorTimers[userId].Dispose();
                }
                
                // Set new timer to remove cursor after 3 seconds of inactivity
                var timer = new System.Timers.Timer(3000) { AutoReset = false };
                timer.Elapsed += (s, e) => {
                    activeCursors.Remove(userId);
                    InvokeAsync(StateHasChanged);
                };
                timer.Start();
                cursorTimers[userId] = timer;
                
                InvokeAsync(StateHasChanged);
            }
        });

        hubConnection.On<PinboardConnectionDto>("PinboardConnectionCreated", (conn) =>
        {
            if (selectedId == conn.ConversationId)
            {
                if (MyCanvasConnections == null) MyCanvasConnections = new();
                MyCanvasConnections.Add(conn);
                MyCanvasConnections = MyCanvasConnections.ToList();
                InvokeAsync(StateHasChanged);
            }
        });

        hubConnection.On<Guid>("PinboardConnectionDeleted", (connId) =>
        {
            if (MyCanvasConnections != null)
            {
                var conn = MyCanvasConnections.FirstOrDefault(c => c.Id == connId);
                if (conn != null)
                {
                    MyCanvasConnections.Remove(conn);
                    MyCanvasConnections = MyCanvasConnections.ToList();
                    InvokeAsync(StateHasChanged);
                }
            }
        });

        // ── Group Management SignalR Events ─────────────────────
        hubConnection.On<Guid, string?, string?>("GroupUpdated", (convId, title, avatarUrl) =>
        {
            if (inboxItems != null)
            {
                var idx = inboxItems.FindIndex(i => i.ConversationId == convId);
                if (idx != -1)
                {
                    var updated = inboxItems[idx];
                    if (title != null) updated = updated with { Title = title };
                    if (avatarUrl != null) updated = updated with { AvatarUrl = avatarUrl };
                    inboxItems[idx] = updated;
                    if (selectedConversation?.ConversationId == convId)
                        selectedConversation = updated;
                    InvokeAsync(StateHasChanged);
                }
            }
        });

        hubConnection.On<Guid, System.Collections.Generic.List<Guid>>("MembersAdded", (convId, userIds) =>
        {
            // Reload participants nếu đang xem modal của nhóm đó
            if (showProfileModal && selectedConversation?.ConversationId == convId)
            {
                InvokeAsync(async () =>
                {
                    var res = await Http.GetFromJsonAsync<List<ParticipantProfileDto>>($"/api/conversations/{convId}/participants");
                    if (res != null)
                    {
                        conversationParticipants = res;
                        isCurrentUserAdmin = res.Any(p => p.UserId == currentUserId && p.Role == 0);
                        StateHasChanged();
                    }
                });
            }
        });

        hubConnection.On<Guid, Guid>("MemberRemoved", (convId, removedUserId) =>
        {
            if (removedUserId == currentUserId)
            {
                // Mình bị xóa khỏi nhóm
                inboxItems?.RemoveAll(i => i.ConversationId == convId);
                if (selectedConversation?.ConversationId == convId)
                {
                    selectedConversation = null;
                    selectedId = Guid.Empty;
                    messages = null;
                    showProfileModal = false;
                }
                InvokeAsync(StateHasChanged);
            }
            else if (showProfileModal && selectedConversation?.ConversationId == convId)
            {
                conversationParticipants?.RemoveAll(p => p.UserId == removedUserId);
                InvokeAsync(StateHasChanged);
            }
        });

        hubConnection.On<Guid>("GroupDisbanded", (convId) =>
        {
            inboxItems?.RemoveAll(i => i.ConversationId == convId);
            if (selectedConversation?.ConversationId == convId)
            {
                selectedConversation = null;
                selectedId = Guid.Empty;
                messages = null;
                showProfileModal = false;
                showDisbandConfirm = false;
            }
            InvokeAsync(StateHasChanged);
        });

        objRef = DotNetObjectReference.Create(this);

        try
        {
            await hubConnection.StartAsync();
            await LoadInbox();
        }
        catch (Exception ex)
        {
            errorMessage = "Lỗi kết nối máy chủ. Vui lòng thử đăng nhập lại.";
            // Token có thể đã hết hạn hoặc server lỗi, ép tải lại trang để middleware Auth xử lý
            if (ex.Message.Contains("401") || (ex.InnerException != null && ex.InnerException.Message.Contains("401")))
            {
                Nav.NavigateTo("/login");
            }
        }
    }

    private async Task LoadInbox()
    {
        isLoading = true;
        errorMessage = null;
        StateHasChanged();
        try
        {
            inboxItems = await Http.GetFromJsonAsync<List<InboxItemDto>>(
                $"/api/conversations/inbox");
            
            if (inboxItems != null && hubConnection != null)
            {
                foreach (var item in inboxItems)
                {
                    await hubConnection.SendAsync("JoinChatRoom", item.ConversationId.ToString());
                }
            }
        }
        catch
        {
            errorMessage = "Không thể tải danh sách tin nhắn.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task TogglePin(Guid conversationId, bool isPinned)
    {
        try
        {
            var body = new { IsPinned = isPinned };
            var response = await Http.PostAsJsonAsync($"/api/conversations/{conversationId}/pin", body);
            
            if (response.IsSuccessStatusCode)
            {
                if (inboxItems != null)
                {
                    var item = inboxItems.FirstOrDefault(i => i.ConversationId == conversationId);
                    if (item != null)
                    {
                        var updatedItem = item with { IsPinned = isPinned };
                        var idx = inboxItems.IndexOf(item);
                        inboxItems[idx] = updatedItem;
                        inboxItems = inboxItems.OrderByDescending(x => x.IsPinned).ThenByDescending(x => x.LastMessageAt).ToList();
                        StateHasChanged();
                    }
                }
            }
        }
        catch { }
    }

    private async Task SelectConversation(InboxItemDto item)
    {
        if (selectedId == item.ConversationId) return;

        selectedConversation = item;
        selectedId = item.ConversationId;
        messages = null;
        isLoadingMessages = true;
        messagesRendered = false; // Reset cờ render
        StateHasChanged();

        try
        {
            var msgTask = Http.GetFromJsonAsync<List<MessageDto>>($"/api/messages/{selectedId}");
            var canvasTask = Http.GetFromJsonAsync<List<PinboardItemDto>>($"/api/pinboard/conversation/{selectedId}");
            var connTask = Http.GetFromJsonAsync<List<PinboardConnectionDto>>($"/api/pinboard/{selectedId}/connections");
            var partTask = Http.GetFromJsonAsync<List<ParticipantProfileDto>>($"/api/conversations/{selectedId}/participants");
            
            await Task.WhenAll(msgTask, canvasTask, connTask, partTask);
            
            messages = msgTask.Result ?? new List<MessageDto>();
            MyCanvasItems = canvasTask.Result ?? new List<PinboardItemDto>();
            MyCanvasConnections = connTask.Result ?? new List<PinboardConnectionDto>();
            conversationParticipants = partTask.Result ?? new List<ParticipantProfileDto>();
        }
        catch
        {
            messages = new List<MessageDto>();
            MyCanvasItems = new List<PinboardItemDto>();
        }
