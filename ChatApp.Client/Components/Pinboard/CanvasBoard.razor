@using ChatApp.Shared.DTOs.Pinboard
@using ChatApp.Shared.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS

<div class="panzoom-wrapper" id="pinboard-canvas">
    <div class="canvas-board" id="canvas-board-inner">
        
        <svg class="canvas-svg-layer">
        <defs>
            <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
                <circle cx="2" cy="2" r="1.5" fill="rgba(150, 150, 150, 0.2)" />
            </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid)" />
        
        @if (Connections != null && Items != null)
        {
            var drawnPairs = new HashSet<string>();
            @foreach (var conn in Connections)
            {
                var minId = conn.SourceItemId.CompareTo(conn.TargetItemId) < 0 ? conn.SourceItemId : conn.TargetItemId;
                var maxId = conn.SourceItemId.CompareTo(conn.TargetItemId) > 0 ? conn.SourceItemId : conn.TargetItemId;
                var pairKey = $"{minId}_{maxId}";
                if (drawnPairs.Contains(pairKey)) continue;
                drawnPairs.Add(pairKey);

                var src = Items.FirstOrDefault(i => i.Id == conn.SourceItemId);
                var tgt = Items.FirstOrDefault(i => i.Id == conn.TargetItemId);
                if (src != null && tgt != null)
                {
                    var c1X = src.PositionX + 140; 
                    var c1Y = src.PositionY + 80;
                    var c2X = tgt.PositionX + 140;
                    var c2Y = tgt.PositionY + 80;
                    var p1 = GetBoundaryPoint(c1X, c1Y, c2X, c2Y);
                    var p2 = GetBoundaryPoint(c2X, c2Y, c1X, c1Y);
                    var midX = p1.X + (p2.X - p1.X) / 2;
                    var pathData = System.FormattableString.Invariant($"M {p1.X} {p1.Y} C {midX} {p1.Y}, {midX} {p2.Y}, {p2.X} {p2.Y}");
                    <path @key="conn.Id" 
                          d="@pathData" 
                          data-source-id="@conn.SourceItemId"
                          data-target-id="@conn.TargetItemId"
                          fill="none" 
                          stroke="var(--accent-primary)" 
                          stroke-width="6" 
                          class="canvas-connection" 
                          style="cursor: pointer;"
                          @onclick="() => HandleConnectionDeleted(conn.Id)"
                          title="Nhấn để xóa đường nối" />
                }
            }
        }
    </svg>

        @if (ActiveCursors != null)
        {
            @foreach (var cursor in ActiveCursors)
            {
                <div class="live-cursor" style="transform: translate(@(cursor.Value.X.ToString(System.Globalization.CultureInfo.InvariantCulture))px, @(cursor.Value.Y.ToString(System.Globalization.CultureInfo.InvariantCulture))px);">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="@cursor.Value.Color" xmlns="http://www.w3.org/2000/svg">
                        <path d="M5.5 3.21V20.8c0 .45.54.67.85.35l4.86-4.86a.5.5 0 0 1 .35-.15h6.87c.45 0 .67-.54.35-.85L5.85 2.86a.5.5 0 0 0-.85.35Z"/>
                    </svg>
                    <span class="live-cursor-name" style="background-color: @cursor.Value.Color">@cursor.Value.Name</span>
                </div>
            }
        }

    <!-- ══ KHUNG LÀM VIỆC CHÍNH ══ -->
    <div class="workspace-frame">
        <div class="frame-title">Khung làm việc chính</div>
    </div>

    @if (Items != null)
    {
        @foreach (var item in Items)
        {
            bool isConnecting = connectingSourceId == item.Id;
            if (item.Type == PinboardItemType.Task)
            {
                <TaskCard @key="item.Id" Item="item" IsConnecting="isConnecting" OnConnectClicked="HandleConnectClicked" OnTaskCompleted="HandleTaskCompleted" OnTaskDeleted="HandleItemDeleted" OnContentUpdated="HandleContentUpdated" />
            }
            else if (item.Type == PinboardItemType.Image)
            {
                <ImageCard @key="item.Id" Item="item" IsConnecting="isConnecting" OnConnectClicked="HandleConnectClicked" OnTaskDeleted="HandleItemDeleted" />
            }
            else if (item.Type == PinboardItemType.File)
            {
                <FileCard @key="item.Id" Item="item" IsConnecting="isConnecting" OnConnectClicked="HandleConnectClicked" OnTaskDeleted="HandleItemDeleted" />
            }
            else
            {
                <StickyNote @key="item.Id" Item="item" IsConnecting="isConnecting" OnConnectClicked="HandleConnectClicked" OnTaskDeleted="HandleItemDeleted" OnContentUpdated="HandleContentUpdated" />
            }
        }
    }
    </div>

    <!-- Nút Tạo Mới Trên Canvas -->
    <div class="canvas-floating-toolbar">
        <button class="btn btn-create-note" @onclick="CreateNewStickyNote" title="Tạo Note">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            Note
        </button>
        <button class="btn btn-create-task" @onclick="CreateNewTask" title="Tạo Task">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            Task
        </button>
    </div>
</div>

@code {
    private (double X, double Y) GetBoundaryPoint(double cX, double cY, double tX, double tY, double width = 280, double height = 160)
    {
        double dx = tX - cX;
        double dy = tY - cY;
        if (Math.Abs(dx) < 0.001 && Math.Abs(dy) < 0.001) return (cX, cY);

        double w = width / 2;
        double h = height / 2;
        double slope = dy / dx;

        double xEdge = dx > 0 ? w : -w;
        double yAtXEdge = slope * xEdge;

        if (Math.Abs(yAtXEdge) <= h) return (cX + xEdge, cY + yAtXEdge);

        double yEdge = dy > 0 ? h : -h;
        double xAtYEdge = yEdge / slope;
        return (cX + xAtYEdge, cY + yEdge);
    }

    [Parameter]
    public List<PinboardItemDto> Items { get; set; } = new();

    [Parameter]
    public List<PinboardConnectionDto> Connections { get; set; } = new();

    [Parameter]
    public EventCallback<Guid> OnTaskCompleted { get; set; }

    [Parameter]
    public EventCallback<Guid> OnItemDeleted { get; set; }

    [Parameter]
    public EventCallback<(Guid id, string content, string? color)> OnItemContentUpdated { get; set; }

    [Parameter]
    public EventCallback<(Guid sourceId, Guid targetId)> OnConnectionCreated { get; set; }

    [Parameter]
    public EventCallback<Guid> OnConnectionDeleted { get; set; }

    private Guid? connectingSourceId = null;

    [Parameter]
    public Dictionary<Guid, (double X, double Y, string Name, string Color)> ActiveCursors { get; set; } = new();

    [Parameter]
    public EventCallback<(Guid id, double x, double y)> OnItemMoved { get; set; }

    [Parameter]
    public EventCallback<(Guid id, double x, double y)> OnItemMovedLive { get; set; }

    [Parameter]
    public EventCallback<(double x, double y)> OnCursorMovedEvent { get; set; }

    [Parameter]
    public EventCallback<(Guid, string, double, double)> OnItemCreatedFromDrop { get; set; }

    private DotNetObjectReference<CanvasBoard>? _objRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _objRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("canvasPhysics.initCanvas", _objRef, "pinboard-canvas");
            await JS.InvokeVoidAsync("canvasPhysics.initDraggableCards", _objRef);
        }
        try {
            await JS.InvokeVoidAsync("canvasPhysics.updateAllConnections");
        } catch { }
    }

    [JSInvokable]
    public async Task OnMessageDropped(string msgId, string content, double x, double y)
    {
        if (Guid.TryParse(msgId, out var parsedId))
        {
            await OnItemCreatedFromDrop.InvokeAsync((parsedId, content, x, y));
        }
    }

    [JSInvokable]
    public async Task OnFileDropped(string url, string fileName, bool isImage, double x, double y)
    {
        var payload = isImage ? url : $"{url}|{fileName}";
        var msgId = isImage ? Guid.Empty : Guid.Parse("00000000-0000-0000-0000-000000000001");
        // We use a dummy Guid to distinguish between File and Image drop from desktop
        await OnItemCreatedFromDrop.InvokeAsync((msgId, payload, x, y));
    }

    [JSInvokable]
    public async Task OnCardMoved(string itemId, double x, double y)
    {
        if (Guid.TryParse(itemId, out var parsedId))
        {
            await OnItemMoved.InvokeAsync((parsedId, x, y));
        }
    }

    [JSInvokable]
    public async Task OnCardMovedLive(string itemId, double x, double y)
    {
        if (Guid.TryParse(itemId, out var parsedId))
        {
            await OnItemMovedLive.InvokeAsync((parsedId, x, y));
        }
    }

    [JSInvokable]
    public async Task OnItemContentUpdatedJs(string idStr, string newContent)
    {
        if (Guid.TryParse(idStr, out var id))
        {
            await OnItemContentUpdated.InvokeAsync((id, newContent, null));
        }
    }

    [JSInvokable]
    public async Task OnCardsDeletedJS(string[] itemIds)
    {
        foreach (var idStr in itemIds)
        {
            if (Guid.TryParse(idStr, out var parsedId))
            {
                await OnItemDeleted.InvokeAsync(parsedId);
            }
        }
    }

    [JSInvokable("OnCursorMoved")]
    public async Task OnCursorMoved(double x, double y)
    {
        if (OnCursorMovedEvent.HasDelegate)
        {
            await OnCursorMovedEvent.InvokeAsync((x, y));
        }
    }

    private async Task HandleTaskCompleted(Guid itemId)
    {
        var item = Items?.FirstOrDefault(i => i.Id == itemId);
        if (item != null)
        {
            // Trigger confetti locally first for instant feedback
            await JS.InvokeVoidAsync("canvasPhysics.triggerConfetti", itemId.ToString());
        }
        await OnTaskCompleted.InvokeAsync(itemId);
    }

    private async Task HandleItemDeleted(Guid itemId)
    {
        await OnItemDeleted.InvokeAsync(itemId);
    }

    private async Task HandleConnectClicked(Guid itemId)
    {
        if (connectingSourceId == null)
        {
            connectingSourceId = itemId;
        }
        else if (connectingSourceId == itemId)
        {
            connectingSourceId = null; // Huỷ
        }
        else
        {
            if (OnConnectionCreated.HasDelegate)
            {
                await OnConnectionCreated.InvokeAsync((connectingSourceId.Value, itemId));
            }
            connectingSourceId = null;
        }
    }

        private async Task HandleConnectionDeleted(Guid connectionId)
    {
        if (OnConnectionDeleted.HasDelegate)
        {
            await OnConnectionDeleted.InvokeAsync(connectionId);
        }
    }
    private async Task HandleContentUpdated((Guid id, string content, string? color) data)
    {
        await OnItemContentUpdated.InvokeAsync(data);
    }

    public void Dispose()
    {
        _objRef?.Dispose();
    }

    [Parameter]
    public EventCallback<PinboardItemType> OnCreateItemRequested { get; set; }

    private async Task CreateNewStickyNote()
    {
        await OnCreateItemRequested.InvokeAsync(PinboardItemType.StickyNote);
    }

    private async Task CreateNewTask()
    {
        await OnCreateItemRequested.InvokeAsync(PinboardItemType.Task);
    }
}
