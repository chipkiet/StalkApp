@using ChatApp.Shared.DTOs.Pinboard

<div class="pinboard-card sticky-note @(IsConnecting ? "card-connecting" : "")" 
     data-id="@Item.Id" 
     data-x="@(Item.PositionX.ToString(System.Globalization.CultureInfo.InvariantCulture))" 
     data-y="@(Item.PositionY.ToString(System.Globalization.CultureInfo.InvariantCulture))"
     style="background-color: @(Item.Color ?? "#ffeb3b"); transform: translate(@(Item.PositionX.ToString(System.Globalization.CultureInfo.InvariantCulture))px, @(Item.PositionY.ToString(System.Globalization.CultureInfo.InvariantCulture))px); z-index: @Item.ZIndex;">
    
    <div class="note-header">
        <span class="note-icon text-warning">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 1.25rem; height: 1.25rem; transform: rotate(45deg);">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
        </span>
        <div class="task-toolbar">
            <input type="color" class="color-picker-btn" style="width:20px;height:20px;padding:0;border:none;background:transparent;cursor:pointer;margin-right:4px;" value="@(Item.Color ?? "#ffeb3b")" @onchange="@(e => ChangeColor(e.Value?.ToString()))" title="Đổi màu" />
            <button class="btn-tool text-accent" @onclick="HandleConnectClicked" title="Nối thẻ">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 1.15rem; height: 1.15rem;">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
                </svg>
            </button>
            <button class="btn-tool text-danger" @onclick="DeleteCard" title="Xóa">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 1.15rem; height: 1.15rem;">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                </svg>
            </button>
        </div>
    </div>
    
    <div class="task-content" @ondblclick="StartEditing">
        @if (isEditing)
        {
            <textarea class="edit-textarea" 
                      @bind="editContent" 
                      @bind:event="oninput" 
                      @onblur="SaveEdit" 
                      @onkeydown="HandleKeyDown"
                      autoFocus></textarea>
        }
        else
        {
            @((MarkupString)ParseLinks(Item.Content))
        }
    </div>
</div>

@code {
    [Parameter]
    public PinboardItemDto Item { get; set; } = null!;

    [Parameter]
    public bool IsConnecting { get; set; }

    [Parameter]
    public EventCallback<Guid> OnTaskDeleted { get; set; }

    [Parameter]
    public EventCallback<Guid> OnTaskCompleted { get; set; }

    [Parameter]
    public EventCallback<Guid> OnConnectClicked { get; set; }

    [Parameter]
    public EventCallback<(Guid id, string content, string? color)> OnContentUpdated { get; set; }

    private bool isEditing = false;
    private string editContent = "";

    private async Task CompleteTask()
    {
        if (!Item.IsCompleted)
        {
            await OnTaskCompleted.InvokeAsync(Item.Id);
        }
    }

    private async Task ChangeColor(string? newColor)
    {
        newColor = newColor ?? "#ffeb3b";
        Item.Color = newColor;
        if (OnContentUpdated.HasDelegate)
        {
            await OnContentUpdated.InvokeAsync((Item.Id, Item.Content, newColor));
        }
    }

    private async Task DeleteCard()
    {
        await OnTaskDeleted.InvokeAsync(Item.Id);
    }

    private void StartEditing()
    {
        isEditing = true;
        editContent = Item.Content;
    }

    private async Task SaveEdit()
    {
        if (isEditing)
        {
            isEditing = false;
            if (editContent != Item.Content)
            {
                await OnContentUpdated.InvokeAsync((Item.Id, editContent, Item.Color));
            }
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SaveEdit();
        }
        else if (e.Key == "Escape")
        {
            isEditing = false;
        }
    }

    private async Task HandleConnectClicked()
    {
        if (OnConnectClicked.HasDelegate)
        {
            await OnConnectClicked.InvokeAsync(Item.Id);
        }
    }
    private string ParseLinks(string? content)
    {
        if (string.IsNullOrWhiteSpace(content)) return "";
        var encoded = System.Net.WebUtility.HtmlEncode(content);
        var urlRegex = new System.Text.RegularExpressions.Regex(
            @"(http|https)://([\w_-]+(?:(?:\.[\w_-]+)+))([\w.,@?^=%&:/~+#-]*[\w@?^=%&/~+#-])?",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            
        return urlRegex.Replace(encoded, "<a href=\"$0\" target=\"_blank\" class=\"text-accent\" style=\"text-decoration: underline;\" onclick=\"event.stopPropagation()\">$0</a>").Replace("\n", "<br/>");
    }
}