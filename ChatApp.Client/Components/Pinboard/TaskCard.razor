@using ChatApp.Shared.DTOs.Pinboard

<div class="pinboard-card task-card @(Item.IsCompleted ? "completed" : "") @(IsConnecting ? "card-connecting" : "")" 
     data-id="@Item.Id" 
     data-x="@(Item.PositionX.ToString(System.Globalization.CultureInfo.InvariantCulture))" 
     data-y="@(Item.PositionY.ToString(System.Globalization.CultureInfo.InvariantCulture))"
     style="background-color: @(Item.Color ?? "#ffffff"); transform: translate(@(Item.PositionX.ToString(System.Globalization.CultureInfo.InvariantCulture))px, @(Item.PositionY.ToString(System.Globalization.CultureInfo.InvariantCulture))px); z-index: @Item.ZIndex;">
    
    <div class="task-header">
        <span class="task-icon text-accent">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 1.25rem; height: 1.25rem;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z" />
            </svg>
        </span>
        <div class="task-toolbar">
            <input type="color" class="color-picker-btn" style="width:20px;height:20px;padding:0;border:none;background:transparent;cursor:pointer;margin-right:4px;" value="@(Item.Color ?? "#ffffff")" @onchange="@(e => ChangeColor(e.Value?.ToString()))" title="Đổi màu" />
            <button class="btn-tool text-accent" @onclick="HandleConnectClicked" title="Nối thẻ">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 1.15rem; height: 1.15rem;">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
                </svg>
            </button>
            <button class="btn-tool text-danger" @onclick="DeleteCard" title="Xóa">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 1.15rem; height: 1.15rem;">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                </svg>
            </button>
        </div>
        @if (Item.Deadline.HasValue)
        {
            <span class="task-deadline @(Item.Deadline < DateTime.UtcNow && !Item.IsCompleted ? "overdue" : "")">
                @Item.Deadline.Value.ToString("dd/MM HH:mm")
            </span>
        }
    </div>
    
    <div class="task-content" @ondblclick="StartEditing">
        @if (isEditing)
        {
            <textarea class="edit-textarea" 
                      @bind="editContent" 
                      @bind:event="oninput" 
                      @onblur="SaveEdit" 
                      @onkeydown="HandleKeyDown"
                      autoFocus></textarea>
        }
        else
        {
            @((MarkupString)ParseLinks(Item.Content))
        }
    </div>
    
    <div class="task-footer">
        @if (!Item.IsCompleted)
        {
            <button class="btn-complete-task" @onclick="CompleteTask">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" style="width: 1rem; height: 1rem;">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                Hoàn thành
            </button>
        }
        else
        {
            <span class="task-done-badge d-flex align-items-center gap-1">
                Đã xong 
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 1.15rem; height: 1.15rem;">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </span>
        }
    </div>
</div>

@code {
    [Parameter]
    public PinboardItemDto Item { get; set; } = null!;

    [Parameter]
    public bool IsConnecting { get; set; }

    [Parameter]
    public EventCallback<Guid> OnTaskCompleted { get; set; }

    [Parameter]
    public EventCallback<Guid> OnTaskDeleted { get; set; }

    [Parameter]
    public EventCallback<Guid> OnConnectClicked { get; set; }

    [Parameter]
    public EventCallback<(Guid id, string content, string? color)> OnContentUpdated { get; set; }

    private bool isEditing = false;
    private string editContent = "";

    private async Task CompleteTask()
    {
        if (!Item.IsCompleted)
        {
            Item.IsCompleted = true; // Optimistic update
            await OnTaskCompleted.InvokeAsync(Item.Id);
        }
    }

    private async Task ChangeColor(string? newColor)
    {
        newColor = newColor ?? "#ffffff";
        Item.Color = newColor;
        if (OnContentUpdated.HasDelegate)
        {
            await OnContentUpdated.InvokeAsync((Item.Id, Item.Content, newColor));
        }
    }

    private async Task DeleteCard()
    {
        await OnTaskDeleted.InvokeAsync(Item.Id);
    }

    private void StartEditing()
    {
        isEditing = true;
        editContent = Item.Content;
    }

    private async Task SaveEdit()
    {
        if (isEditing)
        {
            isEditing = false;
            if (editContent != Item.Content)
            {
                await OnContentUpdated.InvokeAsync((Item.Id, editContent, Item.Color));
            }
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SaveEdit();
        }
        else if (e.Key == "Escape")
        {
            isEditing = false;
        }
    }

    private async Task HandleConnectClicked()
    {
        if (OnConnectClicked.HasDelegate)
        {
            await OnConnectClicked.InvokeAsync(Item.Id);
        }
    }
    private string ParseLinks(string? content)
    {
        if (string.IsNullOrWhiteSpace(content)) return "";
        var encoded = System.Net.WebUtility.HtmlEncode(content);
        var urlRegex = new System.Text.RegularExpressions.Regex(
            @"(http|https)://([\w_-]+(?:(?:\.[\w_-]+)+))([\w.,@?^=%&:/~+#-]*[\w@?^=%&/~+#-])?",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            
        return urlRegex.Replace(encoded, "<a href=\"$0\" target=\"_blank\" class=\"text-accent\" style=\"text-decoration: underline;\" onclick=\"event.stopPropagation()\">$0</a>").Replace("\n", "<br/>");
    }
}