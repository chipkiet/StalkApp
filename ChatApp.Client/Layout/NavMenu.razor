@using ChatApp.Shared.DTOs.Friends
@using Microsoft.AspNetCore.SignalR.Client
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="nav-sidebar">

    <!-- Brand -->
    <div class="nav-brand">
        <span class="nav-brand-logo">S</span>
        <span class="nav-brand-name">STALK</span>
    </div>

    <!-- User Info -->
    <div class="nav-user-card">
        <div class="nav-avatar" style="@(string.IsNullOrEmpty(AvatarUrl) ? "" : $"background-image:url('{AvatarUrl}');background-size:cover;background-position:center;")">
            @if (string.IsNullOrEmpty(AvatarUrl))
            {
                <span>@AvatarInitials</span>
            }
        </div>
        <div class="nav-user-info">
            <div class="nav-user-display">@DisplayName</div>
            <div class="nav-user-phone">@PhoneNumber</div>
        </div>
    </div>

    <!-- Navigation -->
    <nav class="nav-links">
        <NavLink class="nav-item" href="" Match="NavLinkMatch.All">
            <span class="nav-icon">💬</span>
            <span>Tin nhắn</span>
        </NavLink>
        <NavLink class="nav-item nav-item-contacts" href="contacts">
            <span class="nav-icon">👥</span>
            <span>Danh bạ</span>
            @if (pendingCount > 0)
            {
                <span class="nav-badge">@(pendingCount > 9 ? "9+" : pendingCount.ToString())</span>
            }
        </NavLink>
        <NavLink class="nav-item" href="profile">
            <span class="nav-icon">👤</span>
            <span>Hồ sơ</span>
        </NavLink>
    </nav>

    <!-- Logout -->
    <div class="nav-footer">
        <button class="nav-logout-btn" @onclick="Logout">
            <span>⎋</span>
            <span>Đăng xuất</span>
        </button>
    </div>

</div>

@code {
    private string DisplayName = "Đang tải...";
    private string PhoneNumber = "";
    private string AvatarInitials = "?";
    private string? AvatarUrl = null;
    private int pendingCount = 0;

    private HubConnection? hubConnection;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            try
            {
                var profile = await Http.GetFromJsonAsync<UserProfileDto>("/api/users/me");
                if (profile != null)
                {
                    DisplayName = profile.DisplayName ?? "Người dùng";
                    PhoneNumber = profile.PhoneNumber ?? "";
                    AvatarUrl = profile.AvatarUrl;
                    AvatarInitials = GetInitials(DisplayName);
                }
            }
            catch
            {
                DisplayName = user.FindFirst("displayName")?.Value
                           ?? user.Identity.Name
                           ?? "Người dùng";
                PhoneNumber = user.FindFirst("phoneNumber")?.Value ?? "";
                AvatarInitials = GetInitials(DisplayName);
            }

            // Lấy số lời mời đang chờ khi load
            await LoadPendingCountAsync();

            // Kết nối SignalR để lắng nghe sự kiện kết bạn real-time
            await StartHubAsync();
        }
    }

    private async Task LoadPendingCountAsync()
    {
        try
        {
            var pending = await Http.GetFromJsonAsync<List<FriendDto>>("/api/friends/pending");
            pendingCount = pending?.Count ?? 0;
        }
        catch
        {
            pendingCount = 0;
        }
    }

    private async Task StartHubAsync()
    {
        try
        {
            hubConnection = new HubConnectionBuilder()
                .WithUrl(Nav.ToAbsoluteUri("/chathub"), options =>
                {
                    options.AccessTokenProvider = async () =>
                    {
                        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
                        return string.IsNullOrEmpty(token) ? null : token.Trim('"');
                    };
                })
                .WithAutomaticReconnect()
                .Build();

            // ── Nhận lời mời kết bạn → tăng badge ──
            hubConnection.On<FriendNotificationDto>("FriendRequestReceived", (dto) =>
            {
                pendingCount++;
                InvokeAsync(StateHasChanged);
            });

            // ── Lời mời được xử lý (accept/decline) → giảm badge ──
            hubConnection.On<FriendNotificationDto>("FriendRequestAccepted", (dto) =>
            {
                // Đây là sự kiện mình accept hoặc được thông báo mình gửi đã được accept
                // Trường hợp mình là addressee đang accept → reset badge
                if (pendingCount > 0) pendingCount = Math.Max(0, pendingCount - 1);
                InvokeAsync(StateHasChanged);
            });

            // ── Lời mời bị từ chối (mình là người nhận đã từ chối) ──
            hubConnection.On<FriendNotificationDto>("FriendRequestDeclined", (dto) =>
            {
                // Badge sẽ đã giảm khi user thao tác decline trực tiếp
                InvokeAsync(StateHasChanged);
            });

            await hubConnection.StartAsync();
        }
        catch
        {
            // Không làm crash app nếu SignalR lỗi
        }
    }

    // Được gọi từ bên ngoài (Contacts.razor) để sync badge khi user đọc lời mời
    public void ResetPendingBadge()
    {
        pendingCount = 0;
        InvokeAsync(StateHasChanged);
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
        return name[0].ToString().ToUpper();
    }

    private async Task Logout()
    {
        if (AuthStateProvider is Providers.CustomAuthStateProvider customProvider)
            await customProvider.MarkUserAsLoggedOut();
        Nav.NavigateTo("/login");
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
            await hubConnection.DisposeAsync();
    }

    private class UserProfileDto
    {
        public Guid Id { get; set; }
        public string? DisplayName { get; set; }
        public string? Username { get; set; }
        public string? PhoneNumber { get; set; }
        public string? AvatarUrl { get; set; }
        public string? Bio { get; set; }
    }
}
